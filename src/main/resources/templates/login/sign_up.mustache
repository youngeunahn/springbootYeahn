{{> layout/header }}
<script type="text/javascript">
    let idChecked = false;

    $(document).ready(function() {
        $('#btnCheckId').on('click', function() {
            const userId = $('input[name="userId"]').val().trim();
            if (userId === '') {
                alert('아이디를 입력해주세요.');
                return;
            }
            $.get('/admin/signUp/checkId', { userId: userId }, function(isDuplicate) {
                if (isDuplicate) {
                    idChecked = false;
                    $('input[name="userId"]').addClass('is-invalid').removeClass('is-valid');
                    $('#userIdFeedback').text('이미 사용 중인 아이디입니다.').removeClass('valid-feedback').addClass('invalid-feedback').show();
                } else {
                    idChecked = true;
                    $('input[name="userId"]').addClass('is-valid').removeClass('is-invalid');
                    $('#userIdFeedback').text('사용 가능한 아이디입니다.').removeClass('invalid-feedback').addClass('valid-feedback').show();
                }
            });
        });

        $('input[name="userId"]').on('input', function() {
            idChecked = false;
            $(this).removeClass('is-valid is-invalid');
            $('#userIdFeedback').hide();
        });
    });

    function fn_signUp() {
        let userId        = $('input[name="userId"]').val().trim();
        let password      = $('input[name="password"]').val().trim();
        let passwordCheck = $('input[name="password_check"]').val().trim();
        let userName      = $('input[name="userName"]').val().trim();
        let email1        = $('input[name="email1"]').val().trim();
        let email2        = $('select[name="email2"]').val();

        if (userId === '') {
            alert('아이디를 입력해주세요.');
            $('input[name="userId"]').focus();
            return false;
        }
        if (!idChecked) {
            alert('아이디 중복체크를 해주세요.');
            $('input[name="userId"]').focus();
            return false;
        }
        if (password === '') {
            alert('비밀번호를 입력해주세요.');
            $('input[name="password"]').focus();
            return false;
        }
        if (passwordCheck === '') {
            alert('비밀번호 확인을 입력해주세요.');
            $('input[name="password_check"]').focus();
            return false;
        }
        if (password !== passwordCheck) {
            alert('비밀번호가 일치하지 않습니다.');
            $('input[name="password_check"]').focus();
            return false;
        }
        if (userName === '') {
            alert('닉네임을 입력해주세요.');
            $('input[name="userName"]').focus();
            return false;
        }
        if (email1 === '') {
            alert('이메일을 입력해주세요.');
            $('input[name="email1"]').focus();
            return false;
        }
        if (email2 === '선택') {
            alert('이메일 도메인을 선택해주세요.');
            $('select[name="email2"]').focus();
            return false;
        }

        $("#sendForm").submit();
    }
</script>

<div class="d-flex justify-content-center align-items-center"
     style="min-height: calc(100vh - 56px); background-color: #f4f6f9;">
    <div class="col-11 col-sm-8 col-md-6 col-lg-5 col-xl-4 my-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h5 class="font-weight-bold mb-1">회원가입</h5>
                    <small class="text-muted">심심할때 쓰는 개발일기</small>
                </div>
                <form id="sendForm" method="post" action="/admin/signUp">
                    <div class="form-group">
                        <label class="small font-weight-bold text-muted mb-1">아이디</label>
                        <div class="input-group">
                            <input type="text" name="userId" class="form-control" placeholder="아이디 입력">
                            <div class="input-group-append">
                                <button type="button" id="btnCheckId" class="btn btn-outline-secondary">중복체크</button>
                            </div>
                        </div>
                        <small id="userIdFeedback" style="display:none;"></small>
                    </div>
                    <div class="form-group">
                        <label class="small font-weight-bold text-muted mb-1">비밀번호</label>
                        <input type="password" name="password" class="form-control" placeholder="비밀번호 입력">
                    </div>
                    <div class="form-group">
                        <label class="small font-weight-bold text-muted mb-1">비밀번호 확인</label>
                        <input type="password" name="password_check" class="form-control" placeholder="비밀번호 확인 입력">
                    </div>
                    <div class="form-group">
                        <label class="small font-weight-bold text-muted mb-1">닉네임</label>
                        <input type="text" name="userName" class="form-control" placeholder="닉네임 입력">
                    </div>
                    <div class="form-group mb-4">
                        <label class="small font-weight-bold text-muted mb-1">이메일</label>
                        <div class="input-group">
                            <input type="text" name="email1" class="form-control" placeholder="이메일">
                            <div class="input-group-append">
                                <span class="input-group-text">@</span>
                            </div>
                            <select name="email2" class="form-control" style="height: calc(1.5em + .75rem + 10px);">
                                <option>선택</option>
                                <option>gmail.com</option>
                                <option>naver.com</option>
                                <option>직접입력</option>
                            </select>
                            <div class="input-group-append">
                                <button type="button" class="btn btn-outline-secondary">이메일 인증</button>
                            </div>
                        </div>
                    </div>
                    <button type="button" class="btn btn-primary btn-block" onclick="fn_signUp();">회원등록</button>
                    <a href="/login" class="btn btn-outline-secondary btn-block mt-2">로그인 화면으로</a>
                </form>
            </div>
        </div>
    </div>
</div>
