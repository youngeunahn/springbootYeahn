<style>
    /* 라이브러리 탭 플랫 스타일 */
    #libraryTab .nav-link {
        border: 0;
        border-bottom: 2px solid transparent;
        color: #6c757d;
        background-color: transparent;
        border-radius: 0;
        transition: all 0.2s;
    }
    #libraryTab .nav-link.active {
        border-bottom: 2px solid #007bff !important;
        color: #007bff !important;
    }
    #libraryTab .nav-link:hover:not(.active) {
        border-bottom: 2px solid #dee2e6;
    }

    /* 페이즈 활성화 스타일 */
    .phase-item { transition: all 0.3s ease; cursor: pointer; border: 1px solid #dee2e6 !important; }
    .phase-item.active {
        border: 1px solid #17a2b8 !important;
        border-left: 8px solid #17a2b8 !important;
        box-shadow: 0 0.5rem 1rem rgba(23, 162, 184, 0.15) !important;
    }
    .phase-item:not(.active):hover { border-color: #17a2b8 !important; }

    /* 신규 항목 강조 효과 */
    @keyframes highlight-fade {
        0% { background-color: #fff3cd; }
        100% { background-color: #ffffff; }
    }
    .new-item-highlight { animation: highlight-fade 2s ease-out; }

    /* 스크롤바 스타일 커스텀 */
    .phase-list::-webkit-scrollbar { width: 6px; }
    .phase-list::-webkit-scrollbar-track { background: #f1f1f1; }
    .phase-list::-webkit-scrollbar-thumb { background: #ccc; border-radius: 10px; }
    .phase-list::-webkit-scrollbar-thumb:hover { background: #17a2b8; }

    /* 작성 폼 레이아웃 고정 */
    .plan-form-header { flex-shrink: 0; }
    .plan-form-footer { flex-shrink: 0; }
    .phase-list { flex-grow: 1; overflow-y: auto; min-height: 0; }

    /* 초소형 폼 컨트롤 */
    .form-control-xs {
        height: calc(1.2em + 0.5rem + 2px);
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        line-height: 1.2;
        border-radius: 0.2rem;
    }
</style>
<script>
    $(document).ready(function() {
        const typeCode = $('button[name="planType"]').filter(function() {
            return String($(this).data('selected')).toLowerCase() === 'true';
        }).data('type') || 'GYM';

        // 단계(Phase) 코드 리스트
        const phaseCodes = [
            {{#phaseCodes}}
            { code: '{{typeCode}}', desc: '{{codeDesc}}' },
            {{/phaseCodes}}
        ];

        // 폼 진입 시 1회 로딩 후 캐싱되는 코드 데이터
        let currentCodeData = null;

        // 유형에 따른 이모지 설정
        if (typeCode === 'SWIM') {
            $('#emptyPlanEmoji').text('🏊');
        } else {
            $('#emptyPlanEmoji').text('🔥');
        }

        // 유형 선택
        $('[name=planType]').on('click', function() {
            const menuCode = $('[name=menuCode]').val();
            window.location.href = '/exercise/plan?menuCode=' + menuCode + '&typeCode=' + $(this).data('type');
        });

        // 추가 버튼 클릭 이벤트
        $(document).on('click', '#btnCreatePlan, #btnEmptyCreatePlan', function(e) {
            e.preventDefault();
            openPlanForm();
        });

        // 계획 목록 클릭 (상세 조회)
        $(document).on('click', '#planListContainer .list-group-item', function(e) {
            e.preventDefault();
            const seq = $(this).data('seq');
            $.get('/exercise/plan/' + seq, function(data) {
                renderPlanView(data);
            });
        });

        // 계획 목록 DOM 갱신 함수
        function renderPlanList(data) {
            const $container = $('#planListContainer .list-group');
            $container.empty();
            if (!data || data.length === 0) {
                $container.append($('<div/>', { class: 'p-5 text-center text-muted', text: '등록된 계획이 없습니다.' }));
            } else {
                data.forEach(function(plan) {
                    $('<a/>', {
                        href: '#',
                        class: 'list-group-item list-group-item-action py-3',
                        'data-seq': plan.planSeq,
                        html: '<span class="badge badge-primary mr-2">' + plan.planDate + '</span><span>' + plan.planName + '</span>'
                    }).appendTo($container);
                });
            }
        }

        // 상세 화면 렌더링
        function renderPlanView(data) {
            $('#emptyPlan').addClass('d-none').removeClass('d-flex');
            $('#planForm').addClass('d-none').removeClass('d-flex').empty();
            const $view = $('#planView').empty().removeClass('d-none');

            const $header = $('<div/>', { class: 'd-flex justify-content-between align-items-start mb-4 pb-3 border-bottom' }).appendTo($view);
            const $titleInfo = $('<div/>').appendTo($header);
            $titleInfo.append($('<h3/>', { class: 'mb-1 font-weight-bold', text: data.planName }));
            $titleInfo.append($('<div/>', { class: 'text-muted', html: '<i class="far fa-calendar-alt mr-1"></i> ' + data.planDate }));

            const $actions = $('<div/>', { class: 'btn-group' }).appendTo($header);
            $('<button/>', {
                class: 'btn btn-outline-primary btn-sm',
                html: '<i class="fas fa-edit mr-1"></i> 수정',
                click: function() { openPlanForm(data); }
            }).appendTo($actions);
            $('<button/>', {
                class: 'btn btn-outline-danger btn-sm',
                html: '<i class="fas fa-trash-alt mr-1"></i> 삭제',
                click: function() {
                    if (confirm('정말 삭제하시겠습니까?')) {
                        $.post('/exercise/plan/delete/' + data.planSeq, function() {
                            showToast('삭제되었습니다.');
                            location.reload();
                        });
                    }
                }
            }).appendTo($actions);

            if (data.details && data.details.length > 0) {
                const phases = {};
                data.details.forEach(d => {
                    if (!phases[d.planPhase]) phases[d.planPhase] = [];
                    phases[d.planPhase].push(d);
                });

                Object.keys(phases).forEach(pCode => {
                    const pDesc = (phaseCodes.find(c => c.code === pCode) || {}).desc || pCode;
                    const $pArea = $('<div/>', { class: 'mb-4' }).appendTo($view);
                    $pArea.append($('<h5/>', { class: 'text-primary font-weight-bold mb-3', html: '<span class="badge badge-primary mr-2">' + pDesc + '</span>' }));

                    const $table = $('<table/>', { class: 'table table-sm table-hover border-bottom' }).appendTo($pArea);
                    const $thead = $('<thead/>', { class: 'thead-light' }).appendTo($table);
                    const $trHead = $('<tr/>').appendTo($thead);

                    const headers = ['운동명', 'Set', 'Reps'];
                    if (typeCode === 'SWIM') {
                        headers.push('Cycle', 'Distance');
                    } else {
                        headers.push('Time/Dist');
                    }
                    headers.push('메모');

                    headers.forEach(h => {
                        $('<th/>', { class: 'text-center py-2', text: h }).appendTo($trHead);
                    });

                    const $tbody = $('<tbody/>').appendTo($table);
                    phases[pCode].forEach(ex => {
                        const $tr = $('<tr/>').appendTo($tbody);
                        $('<td/>', { class: 'font-weight-bold py-2', text: ex.planExerName }).appendTo($tr);
                        $('<td/>', { class: 'text-center py-2', text: ex.planSets || '-' }).appendTo($tr);
                        $('<td/>', { class: 'text-center py-2', text: ex.planReps || '-' }).appendTo($tr);
                        if (typeCode === 'SWIM') {
                            $('<td/>', { class: 'text-center py-2', text: ex.planTime || '-' }).appendTo($tr);
                            $('<td/>', { class: 'text-center py-2', text: ex.planTotalDistance || '-' }).appendTo($tr);
                        } else {
                            $('<td/>', { class: 'text-center py-2', text: ex.planTime || '-' }).appendTo($tr);
                        }
                        $('<td/>', { class: 'text-muted small py-2', text: ex.planNote || '' }).appendTo($tr);
                    });
                });
            } else {
                $view.append($('<div/>', { class: 'text-center py-5 text-muted', text: '등록된 운동 정보가 없습니다.' }));
            }
        }

        // 계획 작성 폼 열기
        function openPlanForm(data) {
            const isUpdate = !!data;
            const currentPlanSeq = isUpdate ? data.planSeq : null;

            $('#emptyPlan').addClass('d-none').removeClass('d-flex');
            $('#planView').addClass('d-none');
            const $formContainer = $('#planForm');
            $formContainer.data('isUpdate', isUpdate).empty().removeClass('d-none').addClass('d-flex');

            const $form = $('#planFormBase').clone().removeAttr('id').removeClass('d-none').addClass('d-flex');
            $formContainer.append($form);

            if (typeCode === 'SWIM') {
                $form.find('#totalDistanceArea').removeClass('d-none');
            }

            if ($.fn.datepicker) {
                $form.find('.datepicker').datepicker({
                    dateFormat: 'yy-mm-dd',
                    beforeShow: function(input, inst) {
                        setTimeout(function() {
                            const inputOffset = $(input).offset();
                            const inputWidth = $(input).outerWidth();
                            const dpWidth = inst.dpDiv.outerWidth();
                            inst.dpDiv.css({
                                top: inputOffset.top + $(input).outerHeight(),
                                left: inputOffset.left + inputWidth - dpWidth
                            });
                        }, 0);
                    }
                });
            }

            // 코드 데이터 1회 로딩 후 addPhaseBlock/addExerciseRow에 전달
            $.ajax({
                url: '/api/exercise/templates',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ ref1: typeCode }),
                success: function(codeData) {
                    currentCodeData = codeData;

                    if (!isUpdate) {
                        const now = new Date();
                        const offset = now.getTimezoneOffset() * 60000;
                        const localDate = new Date(now.getTime() - offset).toISOString().split('T')[0];
                        $form.find('[name=planDate]').val(localDate);
                        addPhaseBlock($form.find('.phase-list'), '본운동', codeData);
                    } else {
                        $form.find('[name=planName]').val(data.planName);
                        $form.find('[name=planDate]').val(data.planDate);

                        if (data.details && data.details.length > 0) {
                            const phases = {};
                            data.details.forEach(d => {
                                if (!phases[d.planPhase]) phases[d.planPhase] = [];
                                phases[d.planPhase].push(d);
                            });
                            Object.keys(phases).forEach(pCode => {
                                const $exList = addPhaseBlock($form.find('.phase-list'), pCode, codeData);
                                phases[pCode].forEach(ex => addExerciseRow($exList, ex, codeData));
                            });
                            if (typeCode === 'SWIM') updateTotalDistance($form);
                        }
                    }
                },
                error: function() {
                    showToast('코드 데이터를 불러오지 못했습니다.', 'danger');
                }
            });

            // 페이즈 추가 버튼
            $form.find('.btn-add-phase').on('click', function() {
                addPhaseBlock($form.find('.phase-list'), null, currentCodeData);
            });

            $form.find('.btn-save-plan').on('click', function() {
                const planName = $form.find('[name=planName]').val().trim();
                const planDate = $form.find('[name=planDate]').val().trim();

                if (!planName) { showToast('운동 제목을 입력해주세요.', 'warning'); return; }
                if (!planDate) { showToast('기록 날짜를 선택해주세요.', 'warning'); return; }

                const phases = [];
                $form.find('.phase-item').each(function() {
                    const $phase = $(this);
                    const phaseCode = $phase.find('[name=phaseName]').val();

                    $phase.find('.exercise-item').each(function() {
                        const $ex = $(this);
                        const rowData = {
                            planDetailSeq: $ex.data('attr-seq') || null,
                            planPhase: phaseCode,
                            planCategoryCode: $ex.find('.exercise-part-group .btn.active').val(),
                            planKindCode: typeCode === 'GYM' ? ($ex.find('[name=planKindCode]').val() || 'STRENGTH') : typeCode,
                            planExerName: $ex.find('[name=exerName]').val(),
                            planSets: $ex.find('[name=sets]').val(),
                            planReps: $ex.find('[name=reps]').val(),
                            planNote: $ex.find('[name=memo]').val()
                        };

                        // STEP 1-B: SWIM 모드 distance 필드명 분리
                        if (typeCode === 'SWIM') {
                            rowData.planTime = $ex.find('[name=cycle]').val();
                            rowData.planTotalDistance = $ex.find('[name=distance]').val();
                        } else {
                            rowData.planTime = $ex.find('[name=time]').val();
                            rowData.planTotalDistance = null;
                        }

                        phases.push(rowData);
                    });
                });

                if (phases.length === 0) { showToast('최소 하나 이상의 운동을 추가해주세요.', 'warning'); return; }

                const saveData = {
                    planSeq: currentPlanSeq,
                    planName: planName,
                    planDate: planDate,
                    planTypeCode: typeCode,
                    details: phases
                };

                $.ajax({
                    url: '/exercise/plan/save',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(saveData),
                    success: function(res) {
                        showToast('운동 계획이 저장되었습니다.');
                        location.reload();
                    },
                    error: function(err) {
                        showToast('저장 중 오류가 발생했습니다.', 'danger');
                    }
                });
            });

            // distance/time 이벤트 분기
            const distSelector = typeCode === 'SWIM' ? 'input[name="distance"]' : 'input[name="time"]';
            $form.on('input', distSelector, function() {
                updateTotalDistance($form);
            });
        }

        // 폼 취소 (이벤트 위임)
        $(document).on('click', '.btn-cancel-form', function() {
            const $formContainer = $('#planForm');
            const isUpdate = $formContainer.data('isUpdate');
            $formContainer.addClass('d-none').removeClass('d-flex').empty();
            if (isUpdate) {
                $('#planView').removeClass('d-none');
            } else {
                $('#emptyPlan').removeClass('d-none').addClass('d-flex');
            }
        });

        // typeCode 분기로 올바른 필드 합산
        function updateTotalDistance($form) {
            let total = 0;
            const selector = typeCode === 'SWIM' ? 'input[name="distance"]' : 'input[name="time"]';
            $form.find(selector).each(function() {
                total += parseInt($(this).val()) || 0;
            });
            $form.find('#totalDistance').text(total.toLocaleString());
        }

        // 페이즈(단계) 블록 추가 - codeData 파라미터 추가
        function addPhaseBlock($container, phaseName, codeData) {
            const $phase = $('<div/>', {
                class: 'phase-item mb-4 p-3 bg-light rounded border shadow-xs',
                style: 'border-left: 5px solid #17a2b8 !important;',
                click: function() {
                    $('.phase-item').removeClass('active');
                    $(this).addClass('active');
                }
            });

            const $header = $('<div/>', { class: 'd-flex justify-content-between align-items-center mb-3' }).appendTo($phase);
            const $titleArea = $('<div/>', { class: 'd-flex align-items-center' }).appendTo($header);
            const $rightActionArea = $('<div/>', { class: 'd-flex align-items-center' }).appendTo($header);

            const $btnGroup = $('<div/>', { class: 'btn-group btn-group-xs mr-2' }).appendTo($titleArea);
            const $hiddenInput = $('<input/>', { type: 'hidden', name: 'phaseName' }).appendTo($titleArea);

            phaseCodes.forEach(p => {
                const isSelected = phaseName ? (phaseName === p.desc || phaseName === p.code) : (p.desc === '본운동');
                if (isSelected) $hiddenInput.val(p.code);

                $('<button/>', {
                    type: 'button',
                    class: 'btn btn-xs ' + (isSelected ? 'btn-primary' : 'btn-outline-primary'),
                    text: p.desc,
                    click: function(e) {
                        e.stopPropagation();
                        $(this).siblings().removeClass('btn-primary').addClass('btn-outline-primary');
                        $(this).addClass('btn-primary').removeClass('btn-outline-primary');
                        $hiddenInput.val(p.code);
                    }
                }).appendTo($btnGroup);
            });

            // 수영 모드일 때 Cycle 버튼 추가
            if (typeCode === 'SWIM') {
                const $cycleBtn = $('<button/>', {
                    type: 'button',
                    class: 'btn btn-xs btn-outline-info mr-3',
                    text: 'Cycle(시간)포함',
                    click: function(e) {
                        e.stopPropagation();
                        const isActive = !$(this).hasClass('active');
                        $(this).toggleClass('active', isActive);
                        $(this).toggleClass('btn-outline-info', !isActive);
                        $(this).toggleClass('btn-info', isActive);

                        $phase.find('.exercise-item').each(function() {
                            const $row = $(this).find('.form-row');
                            const name = $row.find('[name=exerName]').val();
                            const sets = $row.find('[name=sets]').val();
                            const reps = $row.find('[name=reps]').val();
                            const cycle = $row.find('[name=cycle]').val() || '';
                            // STEP 1-B: time → distance
                            const distance = $row.find('[name=distance]').val() || '';

                            $row.empty();

                            if (isActive) {
                                // [운동명(col-4), Set(col-2), Reps(col-2), Cycle(col-2), Distance(col-2)]
                                $('<div/>', { class: 'col-4 px-1' }).append($('<input/>', { type: 'text', name: 'exerName', class: 'form-control form-control-sm border-0 font-weight-bold', placeholder: '운동 이름', value: name })).appendTo($row);
                                $('<div/>', { class: 'col-2 px-1' }).append($('<input/>', { type: 'text', name: 'sets', class: 'form-control form-control-sm text-center bg-light border-0 rounded-pill', placeholder: 'Set', value: sets, style: 'font-size: 0.75rem;' })).appendTo($row);
                                $('<div/>', { class: 'col-2 px-1' }).append($('<input/>', { type: 'text', name: 'reps', class: 'form-control form-control-sm text-center bg-light border-0 rounded-pill', placeholder: 'Reps', value: reps, style: 'font-size: 0.75rem;' })).appendTo($row);
                                $('<div/>', { class: 'col-2 px-1' }).append($('<input/>', { type: 'text', name: 'cycle', class: 'form-control form-control-sm text-center bg-light border-0 rounded-pill', placeholder: 'Cycle', value: cycle, style: 'font-size: 0.75rem;' })).appendTo($row);
                                $('<div/>', { class: 'col-2 px-1' }).append($('<input/>', { type: 'text', name: 'distance', class: 'form-control form-control-sm text-center bg-light border-0 rounded-pill', placeholder: 'Distance', value: distance, style: 'font-size: 0.75rem;' })).appendTo($row);
                            } else {
                                // [운동명(col-5), Set(col-2), Reps(col-2), Distance(col-3)]
                                $('<div/>', { class: 'col-5 px-1' }).append($('<input/>', { type: 'text', name: 'exerName', class: 'form-control form-control-sm border-0 font-weight-bold', placeholder: '운동 이름', value: name })).appendTo($row);
                                $('<div/>', { class: 'col-2 px-1' }).append($('<input/>', { type: 'text', name: 'sets', class: 'form-control form-control-sm text-center bg-light border-0 rounded-pill', placeholder: 'Set', value: sets, style: 'font-size: 0.75rem;' })).appendTo($row);
                                $('<div/>', { class: 'col-2 px-1' }).append($('<input/>', { type: 'text', name: 'reps', class: 'form-control form-control-sm text-center bg-light border-0 rounded-pill', placeholder: 'Reps', value: reps, style: 'font-size: 0.75rem;' })).appendTo($row);
                                $('<div/>', { class: 'col-3 px-1' }).append($('<input/>', { type: 'text', name: 'distance', class: 'form-control form-control-sm text-center bg-light border-0 rounded-pill', placeholder: 'Distance', value: distance, style: 'font-size: 0.75rem;' })).appendTo($row);
                            }
                        });

                        updateTotalDistance($phase.closest('#planForm'));
                    }
                });
                $rightActionArea.append($cycleBtn);
            }

            $('<button/>', {
                type: 'button',
                class: 'close text-muted',
                html: '&times;',
                style: 'line-height: 1;',
                click: function(e) {
                    e.stopPropagation();
                    if (confirm('이 단계를 삭제하시겠습니까? 포함된 모든 운동이 사라집니다.')) {
                        const $form = $(this).closest('#planForm');
                        $phase.remove();
                        if (typeCode === 'SWIM') updateTotalDistance($form);
                        if ($('.phase-item.active').length === 0) {
                            $('.phase-item').first().addClass('active');
                        }
                    }
                }
            }).appendTo($rightActionArea);

            const $exList = $('<div/>', {
                class: 'exercise-list',
                html: '<div class="empty-ex-guide text-center py-4 border rounded bg-white text-muted mb-2" style="border-style: dashed !important;">운동을 추가하거나 라이브러리에서 담아주세요.</div>'
            }).appendTo($phase);

            $('<button/>', {
                type: 'button',
                class: 'btn btn-xs btn-block btn-outline-primary mt-2 btn-add-exercise-to-phase',
                text: '+ 운동 추가',
                click: function(e) {
                    e.stopPropagation();
                    addExerciseRow($exList, null, currentCodeData);
                }
            }).appendTo($phase);

            $container.append($phase);

            $('.phase-item').removeClass('active');
            $phase.addClass('active').addClass('new-item-highlight');
            setTimeout(() => $phase.removeClass('new-item-highlight'), 2000);

            setTimeout(() => {
                const containerOffset = $container.offset().top;
                const phaseOffset = $phase.offset().top;
                const currentScroll = $container.scrollTop();
                const targetScroll = phaseOffset - containerOffset + currentScroll - 20;
                $container.stop().animate({ scrollTop: targetScroll }, 300);
            }, 100);

            return $exList;
        }

        // 운동 항목 행 추가
        // $topRow를 먼저 DOM에 삽입, AJAX 제거 후 codeData로 직접 구성
        function addExerciseRow($container, data, codeData) {
            $container.find('.empty-ex-guide').hide();

            const $item = $('<div/>', {
                class: 'p-2 mb-1 bg-white border rounded shadow-xs position-relative exercise-item pr-5',
                'data-attr-seq': data ? data.planDetailSeq : ''
            });

            $item.append($('<button/>', {
                type: 'button',
                class: 'close position-absolute text-muted',
                style: 'top: 15px; right: 10px; z-index: 10; outline: none; font-size: 1.2rem; line-height: 1;',
                html: '&times;',
                click: function() {
                    const $form = $(this).closest('#planForm');
                    $item.remove();
                    if ($container.find('.exercise-item').length === 0) {
                        $container.find('.empty-ex-guide').show();
                    }
                    if (typeCode === 'SWIM') updateTotalDistance($form);
                }
            }));

            // $topRow를 먼저 동기적으로 삽입
            const $topRow = $('<div/>', { class: 'mb-2 d-flex flex-wrap align-items-center' });
            $item.prepend($topRow);

            // codeData로 직접 카테고리 버튼 구성 (AJAX 없음)
            if (codeData) {
                if (typeCode === 'GYM' && codeData.tplKind) {
                    const $kindSelect = $('<select/>', {
                        name: 'planKindCode',
                        class: 'form-control form-control-sm rounded-pill border-primary text-primary font-weight-bold mr-2',
                        style: 'width: auto; height: 24px; padding: 0 10px; font-size: 0.7rem; cursor: pointer; background-color: #f0f7ff; border-width: 1.5px;'
                    });
                    codeData.tplKind.forEach(k => {
                        const $opt = $('<option/>', { value: k.typeCode, text: k.codeDesc });
                        if (data && data.planKindCode === k.typeCode) $opt.attr('selected', 'selected');
                        $kindSelect.append($opt);
                    });
                    $topRow.append($kindSelect);
                }

                const $partGroup = $('<div/>', { class: 'btn-group btn-group-xs exercise-part-group' });
                if (codeData.tplCate) {
                    codeData.tplCate.forEach(function(item) {
                        const active = (data && item.typeCode == data.planCategoryCode) ? ' active' : '';
                        $('<button/>', {
                            type: 'button',
                            class: 'btn btn-xs btn-outline-secondary' + active,
                            text: item.codeDesc,
                            value: item.typeCode,
                            style: 'font-size: 0.7rem; padding: 2px 8px;',
                            click: function() {
                                $(this).siblings().removeClass('active');
                                $(this).addClass('active');
                            }
                        }).appendTo($partGroup);
                    });
                }
                $topRow.append($partGroup);
            }

            const $row = $('<div/>', { class: 'form-row no-gutters' }).appendTo($item);

            const isCycleMode = $container.closest('.phase-item').find('.btn-info.active').length > 0;
            const nameClass = 'form-control form-control-sm border-0 font-weight-bold';

            if (isCycleMode) {
                $('<div/>', { class: 'col-4 px-1' }).append($('<input/>', {
                    type: 'text', name: 'exerName', class: nameClass,
                    placeholder: '운동 이름', value: data ? data.planExerName : ''
                })).appendTo($row);

                // Cycle 모드에서도 distance 사용
                const metrics = [
                    { cls: 'col-2', name: 'sets',     ph: 'Set',      val: data ? data.planSets : '' },
                    { cls: 'col-2', name: 'reps',     ph: 'Reps',     val: data ? data.planReps : '' },
                    { cls: 'col-2', name: 'cycle',    ph: 'Cycle',    val: data ? (typeCode === 'SWIM' ? data.planTime : '') : '' },
                    { cls: 'col-2', name: 'distance', ph: 'Distance', val: data ? (typeCode === 'SWIM' ? data.planTotalDistance : data.planTime) : '' }
                ];

                metrics.forEach(m => {
                    const $col = $('<div/>', { class: m.cls + ' px-1' }).appendTo($row);
                    $col.append($('<input/>', {
                        type: 'text', name: m.name, class: 'form-control form-control-sm text-center bg-light border-0 rounded-pill',
                        placeholder: m.ph, value: m.val || '', style: 'font-size: 0.75rem;'
                    }));
                });
            } else {
                $('<div/>', { class: 'col-5 px-1' }).append($('<input/>', {
                    type: 'text', name: 'exerName', class: nameClass,
                    placeholder: '운동 이름', value: data ? data.planExerName : ''
                })).appendTo($row);

                // STEP 1-B: GYM → time, SWIM → distance
                const metrics = [
                    { cls: 'col-2', name: 'sets', ph: 'Set',  val: data ? data.planSets : '' },
                    { cls: 'col-2', name: 'reps', ph: 'Reps', val: data ? data.planReps : '' },
                    {
                        cls: 'col-3',
                        name: typeCode === 'SWIM' ? 'distance' : 'time',
                        ph:   typeCode === 'SWIM' ? 'Distance' : 'Time/Dist',
                        val:  data ? (typeCode === 'SWIM' ? data.planTotalDistance : data.planTime) : ''
                    }
                ];

                metrics.forEach(m => {
                    const $col = $('<div/>', { class: m.cls + ' px-1' }).appendTo($row);
                    $col.append($('<input/>', {
                        type: 'text', name: m.name, class: 'form-control form-control-sm text-center bg-light border-0 rounded-pill',
                        placeholder: m.ph, value: m.val || '', style: 'font-size: 0.75rem;'
                    }));
                });
            }

            const memoClass = 'form-control form-control-xs mt-2 border-0 bg-light rounded text-muted font-italic';
            const memoStyle = 'font-size: 0.75rem; height: auto; padding: 4px 10px;';

            $item.append($('<input/>', {
                type: 'text',
                name: 'memo',
                class: memoClass,
                placeholder: '메모 (클릭하여 입력)',
                value: data ? data.planNote : '',
                style: memoStyle
            }));

            $container.append($item);
            $item.addClass('new-item-highlight');
            setTimeout(() => $item.removeClass('new-item-highlight'), 2000);
        }

        // 검색창 디바운스 적용
        let searchTimer;
        $('#tplLibSearch').on('keyup', function() {
            const kw = $(this).val().trim().toLowerCase();

            $('#recordListOrigin .record-group').each(function() {
                const $group = $(this);
                $group.toggle($group.text().toLowerCase().indexOf(kw) > -1);
            });

            if (!kw) {
                $('#tplListOrigin').show();
                $('#tplSearchResult').hide();
                return;
            }

            clearTimeout(searchTimer);
            searchTimer = setTimeout(function() {
                $.get('/exercise/plan/search-exercises', { keyword: kw, typeCode: typeCode }, function(data) {
                    $('#tplListOrigin').hide();
                    const $result = $('#tplSearchResult').empty().show();
                    $result.append($('<div/>', { class: 'p-2 bg-light text-muted border-bottom', text: '개별 운동 검색 결과' }));

                    if (!data || data.length === 0) {
                        $result.append($('<div/>', { class: 'p-4 text-center text-muted', text: '검색 결과가 없습니다.' }));
                        return;
                    }

                    data.forEach(ex => {
                        const $div = $('<div/>', { class: 'd-flex align-items-center p-2 border-bottom' });
                        const $check = $('<input/>', {
                            type: 'checkbox',
                            class: 'ex-check',
                            'data-name': ex.tplExerName,
                            'data-sets': ex.tplMeasure1 || '',
                            'data-reps': ex.tplMeasure2 || '',
                            'data-dist': ex.tplTotalDistance || '',
                            'data-memo': ex.tplNote || '',
                            'data-cate': ex.tplCategoryCode || '',
                            'data-kind': ex.tplKindCode || ''
                        });

                        let info = '<strong>' + ex.tplExerName + '</strong>';
                        if (ex.tplMeasure1 || ex.tplMeasure2) {
                            info += ' <span class="text-primary ml-1">[' + (ex.tplMeasure1 || 0) + 'S ' + (ex.tplMeasure2 || 0) + 'R]</span>';
                        }
                        if (ex.tplNote) {
                            info += '<span class="text-muted ml-1">| ' + ex.tplNote + '</span>';
                        }

                        const $label = $('<label/>', {
                            class: 'mb-0 ml-2 cursor-pointer',
                            html: info,
                            click: function() { $check.prop('checked', !$check.prop('checked')); }
                        });
                        $result.append($div.append($check).append($label));
                    });
                });
            }, 300);
        });

        // 기간 검색 구현
        $('#btnSearchApply').on('click', function() {
            const params = {
                planNameSearch: $('#searchPlanName').val(),
                searchStartDate: $('#searchStartDate').val(),
                searchEndDate: $('#searchEndDate').val(),
                planTypeCode: typeCode
            };
            $.get('/exercise/plan/search', params, function(data) {
                renderPlanList(data);
            });
        });

        // 퀵 필터 (과거 기록 탭)
        $(document).on('click', '.btn-quick-filter', function() {
            const now = new Date();
            const offset = now.getTimezoneOffset() * 60000;
            const endDate = new Date(now.getTime() - offset).toISOString().split('T')[0];
            const days = parseInt($(this).data('days'));
            const startDate = new Date(now.getTime() - offset - days * 86400000).toISOString().split('T')[0];

            $.get('/exercise/plan/search', { searchStartDate: startDate, searchEndDate: endDate, planTypeCode: typeCode }, function(data) {
                renderRecordList(data);
            });

            $(this).siblings().removeClass('active');
            $(this).addClass('active');
        });

        // 과거 기록 렌더링
        function renderRecordList(data) {
            const $origin = $('#recordListOrigin').empty();
            if (!data || data.length === 0) {
                $origin.append($('<div/>', { class: 'p-4 text-center text-muted', text: '기록이 없습니다.' }));
                return;
            }
            data.forEach(function(plan) {
                const $group = $('<div/>', { class: 'record-group' }).appendTo($origin);
                $('<a/>', {
                    href: 'javascript:void(0);',
                    class: 'list-group-item list-group-item-action d-flex justify-content-between align-items-center',
                    'data-seq': plan.planSeq,
                    html: '<div><span class="badge badge-secondary mr-2">' + plan.planDate + '</span><span>' + plan.planName + '</span></div><i class="fas fa-chevron-down text-muted"></i>'
                }).appendTo($group);
                $('<div/>', { class: 'tpl-exercises', style: 'display: none;' }).appendTo($group);
            });
        }

        $(document).on('click', '.btn-add-selected', function() {
            const $checked = $('.ex-check:checked');
            if ($('#planForm').hasClass('d-none')) { showToast('작성 폼을 먼저 열어주세요.', 'warning'); return; }

            let $activePhase = $('.phase-item.active');
            if ($activePhase.length === 0) $activePhase = $('.phase-item').last();
            if ($activePhase.length === 0) {
                addPhaseBlock($('#planForm .phase-list'), '본운동', currentCodeData);
                $activePhase = $('.phase-item.active');
            }

            const $container = $activePhase.find('.exercise-list');
            if ($checked.length === 0) { showToast('추가할 운동을 먼저 선택해주세요.', 'warning'); return; }

            $checked.each(function() {
                const $ex = $(this);
                addExerciseRow($container, {
                    planExerName: $ex.data('name'),
                    planSets: $ex.data('sets'),
                    planReps: $ex.data('reps'),
                    planTotalDistance: $ex.data('dist'),
                    planNote: $ex.data('memo'),
                    planCategoryCode: $ex.data('cate') || null,
                    planKindCode: $ex.data('kind') || null
                }, currentCodeData);
                $ex.prop('checked', false);
            });

            if (typeCode === 'SWIM') updateTotalDistance($('#planForm'));

            showToast($checked.length + '개의 운동이 [' + $activePhase.find('input[name=phaseName]').val() + '] 단계에 추가되었습니다.');
        });

        // 템플릿 라이브러리 아코디언
        $('#tplListOrigin').on('click', '.list-group-item', function() {
            const $this = $(this);
            const $area = $this.next('.tpl-exercises');
            const $icon = $this.find('i.fas');

            if ($area.is(':visible')) {
                $area.slideUp(200);
                $icon.css('transform', 'rotate(0deg)');
            } else {
                $('.tpl-exercises').slideUp(200);
                $('.list-group-item i.fas').css('transform', 'rotate(0deg)');

                if ($area.children().length > 0) {
                    $area.slideDown(200);
                    $icon.css('transform', 'rotate(180deg)');
                } else {
                    $.get('/api/exercise/templates/' + $this.data('seq'), function(data) {
                        $area.empty();
                        if (!data || !data.exercises || data.exercises.length === 0) {
                            $area.append($('<div/>', { class: 'p-3 text-center text-muted small', text: '등록된 운동이 없습니다.' }));
                        } else {
                            data.exercises.forEach(ex => {
                                const $div = $('<div/>', { class: 'd-flex align-items-center p-2 border-bottom bg-light', style: 'padding-left: 30px !important;' });
                                const $check = $('<input/>', {
                                    type: 'checkbox', class: 'ex-check',
                                    'data-name': ex.tplExerName,
                                    'data-sets': ex.tplMeasure1 || '',
                                    'data-reps': ex.tplMeasure2 || '',
                                    'data-dist': ex.tplTotalDistance || '',
                                    'data-memo': ex.tplNote || '',
                                    'data-cate': ex.tplCategoryCode || '',
                                    'data-kind': ex.tplKindCode || ''
                                });
                                let info = '<strong>' + ex.tplExerName + '</strong>';
                                if (ex.tplMeasure1 || ex.tplMeasure2) {
                                    info += ' <span class="text-primary ml-1">[' + (ex.tplMeasure1 || 0) + 'S ' + (ex.tplMeasure2 || 0) + 'R]</span>';
                                }
                                if (ex.tplNote) {
                                    info += '<span class="text-muted ml-1">| ' + ex.tplNote + '</span>';
                                }
                                const $span = $('<span/>', {
                                    class: 'ml-2 cursor-pointer', html: info,
                                    click: function() { $check.prop('checked', !$check.prop('checked')); }
                                });
                                $area.append($div.append($check).append($span));
                            });
                        }
                        $area.slideDown(200);
                        $icon.css('transform', 'rotate(180deg)');
                    });
                }
            }
        });

        // 과거 기록 아코디언
        $('#recordListOrigin').on('click', '.list-group-item', function() {
            const $this = $(this);
            const $area = $this.next('.tpl-exercises');
            const $icon = $this.find('i.fas');

            if ($area.is(':visible')) {
                $area.slideUp(200);
                $icon.css('transform', 'rotate(0deg)');
            } else {
                $('#recordListOrigin .tpl-exercises').slideUp(200);
                $('#recordListOrigin .list-group-item i.fas').css('transform', 'rotate(0deg)');

                if ($area.children().length > 0) {
                    $area.slideDown(200);
                    $icon.css('transform', 'rotate(180deg)');
                } else {
                    $.get('/exercise/plan/' + $this.data('seq'), function(data) {
                        $area.empty();
                        if (!data || !data.details || data.details.length === 0) {
                            $area.append($('<div/>', { class: 'p-3 text-center text-muted small', text: '등록된 운동이 없습니다.' }));
                        } else {
                            data.details.forEach(ex => {
                                const $div = $('<div/>', { class: 'd-flex align-items-center p-2 border-bottom bg-light', style: 'padding-left: 30px !important;' });
                                const $check = $('<input/>', {
                                    type: 'checkbox', class: 'ex-check',
                                    'data-name': ex.planExerName,
                                    'data-sets': ex.planSets || '',
                                    'data-reps': ex.planReps || '',
                                    'data-dist': ex.planTotalDistance || '',
                                    'data-memo': ex.planNote || '',
                                    'data-cate': ex.planCategoryCode || '',
                                    'data-kind': ex.planKindCode || ''
                                });
                                let info = '<strong>' + ex.planExerName + '</strong>';
                                if (ex.planSets || ex.planReps) {
                                    info += ' <span class="text-primary ml-1">[' + (ex.planSets || 0) + 'S ' + (ex.planReps || 0) + 'R]</span>';
                                }
                                const $span = $('<span/>', {
                                    class: 'ml-2 cursor-pointer', html: info,
                                    click: function() { $check.prop('checked', !$check.prop('checked')); }
                                });
                                $area.append($div.append($check).append($span));
                            });
                        }
                        $area.slideDown(200);
                        $icon.css('transform', 'rotate(180deg)');
                    });
                }
            }
        });

        $('#searchStartDate').datepicker({ dateFormat: 'yy-mm-dd' });
        $('#searchEndDate').datepicker({ dateFormat: 'yy-mm-dd' });
        $('#btnToggleFilter').on('click', function() { $('#advancedFilter').slideToggle(200); });
        $('#btnSearchReset').on('click', function() { $('#searchPlanName, #searchStartDate, #searchEndDate').val(''); });

        // 과거 기록 탭 초기 전체 로딩
        $.get('/exercise/plan/search', { planTypeCode: typeCode }, function(data) {
            renderRecordList(data);
        });

        // showToast에 type 파라미터 추가 (info / warning / danger / success)
        function showToast(msg, type) {
            type = type || 'info';
            const $t = $('<div/>', {
                class: 'alert alert-' + type + ' position-fixed fixed-bottom m-3 shadow',
                style: 'width: fit-content; left: 50%; transform: translateX(-50%); z-index: 9999; border-radius: 50px;',
                text: msg
            }).appendTo('body');
            $t.fadeIn().delay(1500).fadeOut(function() { $(this).remove(); });
        }
    });
</script>

<input type="hidden" name="menuCode" value="{{menuCode}}">

<div class="row no-gutters" style="height: calc(100vh - 180px);">
    <!-- 1. 왼쪽: 운동 계획 목록 -->
    <div class="col-lg-3 h-100 pr-2">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-white d-flex align-items-center py-2">
                <span class="mr-auto">운동 계획</span>
                <div class="btn-group btn-group-xs mr-2">
                    {{#typeCode}}
                        <button class="btn btn-xs btn{{^isChecked}}-outline{{/isChecked}}-primary" name="planType" data-type="{{typeCode}}" data-selected="{{isChecked}}">{{codeDesc}}</button>
                    {{/typeCode}}
                </div>
                <button id="btnCreatePlan" class="btn btn-primary btn-xs">추가</button>
            </div>
            <div class="p-2 bg-white border-bottom shadow-xs">
                <div class="input-group input-group-sm">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-transparent border-0 text-muted"><i class="fas fa-search"></i></span>
                    </div>
                    <input type="text" id="searchPlanName" class="form-control border-0 shadow-none px-1" placeholder="계획명 검색...">
                    <div class="input-group-append">
                        <button class="btn btn-link text-muted p-1 d-flex align-items-center" type="button" id="btnToggleFilter" style="text-decoration:none;">
                            <i class="fas fa-filter mr-1"></i>
                            <span>기간검색</span>
                        </button>
                    </div>
                </div>
                <div id="advancedFilter" class="mt-2 p-2 bg-light rounded border" style="display:none;">
                    <div class="d-flex align-items-center bg-white rounded border px-1">
                        <input type="text" id="searchStartDate" class="form-control form-control-sm border-0 shadow-none bg-transparent text-center px-0" placeholder="시작일" readonly style="cursor:pointer; font-size: 0.85rem;">
                        <span class="px-1 text-muted">~</span>
                        <input type="text" id="searchEndDate" class="form-control form-control-sm border-0 shadow-none bg-transparent text-center px-0" placeholder="종료일" readonly style="cursor:pointer; font-size: 0.85rem;">
                    </div>
                    <div class="mt-2 d-flex justify-content-between">
                        <button id="btnSearchReset" class="btn btn-link btn-xs text-muted p-0" style="text-decoration:none;">초기화</button>
                        <button id="btnSearchApply" class="btn btn-primary btn-xs px-2 shadow-sm">필터 적용</button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0 overflow-auto" id="planListContainer">
                <div class="list-group list-group-flush">
                    {{#planList}}
                        <a href="#" class="list-group-item list-group-item-action py-3" data-seq="{{planSeq}}">
                            <span class="badge badge-primary mr-2">{{planDate}}</span>
                            <span>{{planName}}</span>
                        </a>
                    {{/planList}}
                    {{^planList}}
                        <div class="p-5 text-center text-muted">등록된 계획이 없습니다.</div>
                    {{/planList}}
                </div>
            </div>
        </div>
    </div>

    <!-- 2. 중앙: 메인 영역 -->
    <div class="col-lg-6 h-100 px-1">
        <div class="card h-100 shadow-sm border-0 d-flex flex-column" style="overflow: hidden;">
            <div id="emptyPlan" class="flex-grow-1 d-flex flex-column align-items-center justify-content-center bg-light" style="min-height: 0;">
                <div class="text-center mb-4">
                    <div class="display-4 mb-2" id="emptyPlanEmoji">🔥</div>
                    <h5 class="text-dark">어떤 운동을 하실 계획인가요?</h5>
                    <p class="text-muted">목록에서 계획을 선택하거나 아래 버튼을 눌러보세요.</p>
                </div>
                <button id="btnEmptyCreatePlan" class="btn btn-primary px-4 rounded-pill">새 운동 계획 만들기</button>
            </div>
            <div id="planForm" class="card-body d-none p-0 flex-grow-1 flex-column" style="min-height: 0;"></div>
            <div id="planView" class="card-body d-none overflow-auto p-4 flex-grow-1" style="min-height: 0;"></div>
        </div>
    </div>

    <!-- 3. 오른쪽: 라이브러리 -->
    <div class="col-lg-3 h-100 pl-2">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-white p-0">
                <ul class="nav nav-tabs nav-fill" id="libraryTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active py-2 font-weight-bold" id="tpl-tab" data-toggle="tab" href="#tplTabContent" role="tab">템플릿</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link py-2 font-weight-bold" id="record-tab" data-toggle="tab" href="#recordTabContent" role="tab">과거 기록</a>
                    </li>
                </ul>
            </div>
            <div class="p-2 bg-white border-bottom shadow-xs">
                <div class="input-group input-group-sm">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-transparent border-0 text-muted"><i class="fas fa-search"></i></span>
                    </div>
                    <input type="text" id="tplLibSearch" class="form-control border-0 shadow-none px-1" placeholder="운동/템플릿 검색...">
                </div>
            </div>
            <div class="card-body p-0 overflow-auto tab-content" id="tplLibContainer">
                <div class="tab-pane fade show active" id="tplTabContent" role="tabpanel">
                    <div class="p-2 bg-white border-bottom">
                        <button class="btn btn-info btn-xs btn-block rounded-pill btn-add-selected">선택한 운동 추가 ↓</button>
                    </div>
                    <div id="tplListOrigin" class="list-group list-group-flush">
                        {{#tplList}}
                            <div class="tpl-group">
                                <a href="javascript:void(0);" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-seq="{{tplSeq}}">
                                    <div><span class="badge badge-primary mr-2">{{tplPhase}}</span><span>{{tplName}}</span></div>
                                    <i class="fas fa-chevron-down text-muted"></i>
                                </a>
                                <div class="tpl-exercises" style="display: none;"></div>
                            </div>
                        {{/tplList}}
                    </div>
                </div>
                <div class="tab-pane fade" id="recordTabContent" role="tabpanel">
                    <div class="p-2 bg-white border-bottom">
                        <div class="d-flex justify-content-between mb-2">
                            <!-- data-days 속성 추가 -->
                            <button class="btn btn-xs btn-outline-secondary btn-quick-filter flex-grow-1 mr-1" data-days="7">최근 1주</button>
                            <button class="btn btn-xs btn-outline-secondary btn-quick-filter flex-grow-1" data-days="30">최근 1달</button>
                        </div>
                        <button class="btn btn-info btn-xs btn-block rounded-pill btn-add-selected">선택한 운동 추가 ↓</button>
                    </div>
                    <div id="recordListOrigin" class="list-group list-group-flush"></div>
                </div>
                <div id="tplSearchResult" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

<!-- 폼 원본 -->
