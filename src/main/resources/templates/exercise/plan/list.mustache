<style>
    /* 라이브러리 탭 플랫 스타일 */
    #libraryTab .nav-link {
        border: 0;
        border-bottom: 2px solid transparent;
        color: #6c757d;
        background-color: transparent;
        border-radius: 0;
        transition: all 0.2s;
    }
    #libraryTab .nav-link.active {
        border-bottom: 2px solid #007bff !important;
        color: #007bff !important;
    }
    #libraryTab .nav-link:hover:not(.active) {
        border-bottom: 2px solid #dee2e6;
    }

    /* 페이즈 활성화 스타일 */
    .phase-item { transition: all 0.3s ease; cursor: pointer; border: 1px solid #dee2e6 !important; }
    .phase-item.active { 
        border: 1px solid #17a2b8 !important; 
        border-left: 8px solid #17a2b8 !important;
        box-shadow: 0 0.5rem 1rem rgba(23, 162, 184, 0.15) !important;
    }
    .phase-item:not(.active):hover { border-color: #17a2b8 !important; }

    /* 신규 항목 강조 효과 */
    @keyframes highlight-fade {
        0% { background-color: #fff3cd; }
        100% { background-color: #ffffff; }
    }
    .new-item-highlight { animation: highlight-fade 2s ease-out; }

    /* 스크롤바 스타일 커스텀 (시인성 확보) */
    .phase-list::-webkit-scrollbar { width: 6px; }
    .phase-list::-webkit-scrollbar-track { background: #f1f1f1; }
    .phase-list::-webkit-scrollbar-thumb { background: #ccc; border-radius: 10px; }
    .phase-list::-webkit-scrollbar-thumb:hover { background: #17a2b8; }

    /* 작성 폼 레이아웃 고정 */
    .plan-form-header { flex-shrink: 0; }
    .plan-form-footer { flex-shrink: 0; }
    .phase-list { flex-grow: 1; overflow-y: auto; min-height: 0; }

    /* 초소형 폼 컨트롤 */
    .form-control-xs {
        height: calc(1.2em + 0.5rem + 2px);
        padding: 0.25rem 0.5rem;
        font-size: 0.75rem;
        line-height: 1.2;
        border-radius: 0.2rem;
    }
</style>
<script>
    $(document).ready(function() {
        const typeCode = $('button[name="planType"][data-selected="true"]').data('type') || 'GYM';
        
        // 단계(Phase) 코드 리스트 정의
        const phaseCodes = [
            {{#phaseCodes}}
            { code: '{{typeCode}}', desc: '{{codeDesc}}' },
            {{/phaseCodes}}
        ];

        // 유형에 따른 이모지 설정
        if (typeCode === 'SWIM') {
            $('#emptyPlanEmoji').text('🏊');
        } else {
            $('#emptyPlanEmoji').text('🔥');
        }

        // 유형 선택
        $('[name=planType]').on('click', function() {
            const menuCode = $('[name=menuCode]').val();
            window.location.href = `/exercise/plan?menuCode=${menuCode}&typeCode=` + $(this).data('type');
        });

        // 추가 버튼 클릭 이벤트
        $(document).on('click', '#btnCreatePlan, #btnEmptyCreatePlan', function(e) {
            e.preventDefault();
            openPlanForm();
        });

        // 계획 작성 폼 열기
        function openPlanForm(data) {
            const isUpdate = !!data;
            $('#emptyPlan').addClass('d-none').removeClass('d-flex');
            $('#planView').addClass('d-none');
            const $formContainer = $('#planForm');
            $formContainer.data('isUpdate', isUpdate).empty().removeClass('d-none').addClass('d-flex');

            const $form = $('#planFormBase').clone().removeAttr('id').removeClass('d-none').addClass('d-flex');
            $formContainer.append($form);

            if (typeCode === 'SWIM') {
                $form.find('#totalDistanceArea').removeClass('d-none');
            }

            if ($.fn.datepicker) { 
                $form.find('.datepicker').datepicker({ 
                    dateFormat: 'yy-mm-dd',
                    beforeShow: function(input, inst) {
                        // Datepicker 팝업 위치를 우측으로 강제 조정
                        setTimeout(function() {
                            const inputOffset = $(input).offset();
                            const inputWidth = $(input).outerWidth();
                            const dpWidth = inst.dpDiv.outerWidth();
                            inst.dpDiv.css({
                                top: inputOffset.top + $(input).outerHeight(),
                                left: inputOffset.left + inputWidth - dpWidth
                            });
                        }, 0);
                    }
                }); 
            }
            
            if (!isUpdate) {
                $form.find('[name=planDate]').val(new Date().toISOString().split('T')[0]);
                addPhaseBlock($form.find('.phase-list'), '본운동');
            }

            // 페이즈 추가 버튼 (맨 하단)
            $form.find('.btn-add-phase').on('click', function() {
                addPhaseBlock($form.find('.phase-list'));
            });

            $form.find('.btn-save-plan').on('click', function() { 
                const phaseCount = $form.find('.phase-item').length;
                if (phaseCount === 0) { alert('최소 하나 이상의 운동 단계를 추가해주세요.'); return; }
                alert('저장 API 연동 필요'); 
            });

            $form.on('input', 'input[name="time"]', function() {
                updateTotalDistance($form);
            });
        }

        // 폼 취소 (이벤트 위임)
        $(document).on('click', '.btn-cancel-form', function() {
            const $formContainer = $('#planForm');
            const isUpdate = $formContainer.data('isUpdate');
            
            $formContainer.addClass('d-none').removeClass('d-flex').empty();
            
            if (isUpdate) {
                $('#planView').removeClass('d-none');
            } else {
                $('#emptyPlan').removeClass('d-none').addClass('d-flex');
            }
        });

        function updateTotalDistance($form) {
            let total = 0;
            $form.find('input[name="time"]').each(function() {
                const val = parseInt($(this).val()) || 0;
                total += val;
            });
            $form.find('#totalDistance').text(total.toLocaleString());
        }

        // 페이즈(단계) 블록 추가
        function addPhaseBlock($container, phaseName) {
            const $phase = $('<div/>', { 
                class: 'phase-item mb-4 p-3 bg-light rounded border shadow-xs',
                style: 'border-left: 5px solid #17a2b8 !important;',
                click: function() {
                    $('.phase-item').removeClass('active');
                    $(this).addClass('active');
                }
            });

            const $header = $('<div/>', { class: 'd-flex justify-content-between align-items-center mb-3' }).appendTo($phase);
            const $titleArea = $('<div/>', { class: 'd-flex align-items-center' }).appendTo($header);
            
            const $btnGroup = $('<div/>', { class: 'btn-group btn-group-xs mr-2' }).appendTo($titleArea);
            const $hiddenInput = $('<input/>', { type: 'hidden', name: 'phaseName' }).appendTo($titleArea);

            // 단계 버튼 생성
            phaseCodes.forEach(p => {
                const isSelected = phaseName ? (phaseName === p.desc || phaseName === p.code) : (p.desc === '본운동');
                if (isSelected) $hiddenInput.val(p.code);

                const $btn = $('<button/>', {
                    type: 'button',
                    class: 'btn btn-xs ' + (isSelected ? 'btn-primary' : 'btn-outline-primary'),
                    text: p.desc,
                    click: function(e) {
                        e.stopPropagation();
                        $(this).siblings().removeClass('btn-primary').addClass('btn-outline-primary');
                        $(this).addClass('btn-primary').removeClass('btn-outline-primary');
                        $hiddenInput.val(p.code);
                    }
                }).appendTo($btnGroup);
            });

            $header.append($('<button/>', {
                type: 'button',
                class: 'close text-muted',
                html: '&times;',
                click: function(e) { 
                    e.stopPropagation();
                    if (confirm('이 단계를 삭제하시겠습니까? 포함된 모든 운동이 사라집니다.')) {
                        const $form = $(this).closest('#planForm');
                        $phase.remove(); 
                        if (typeCode === 'SWIM') updateTotalDistance($form);
                        if ($('.phase-item.active').length === 0) {
                            $('.phase-item').first().addClass('active');
                        }
                    }
                }
            }));

            const $exList = $('<div/>', { 
                class: 'exercise-list',
                html: '<div class="empty-ex-guide text-center py-4 border rounded bg-white text-muted mb-2" style="border-style: dashed !important;">운동을 추가하거나 라이브러리에서 담아주세요.</div>'
            }).appendTo($phase);
            
            $('<button/>', {
                type: 'button',
                class: 'btn btn-xs btn-block btn-outline-primary mt-2 btn-add-exercise-to-phase',
                text: '+ 운동 추가',
                click: function(e) { 
                    e.stopPropagation();
                    addExerciseRow($exList); 
                }
            }).appendTo($phase);

            $container.append($phase);

            $('.phase-item').removeClass('active');
            $phase.addClass('active').addClass('new-item-highlight');
            setTimeout(() => $phase.removeClass('new-item-highlight'), 2000);
            
            setTimeout(() => {
                const containerOffset = $container.offset().top;
                const phaseOffset = $phase.offset().top;
                const currentScroll = $container.scrollTop();
                const targetScroll = phaseOffset - containerOffset + currentScroll - 20;
                $container.stop().animate({ scrollTop: targetScroll }, 300);
            }, 100);

            return $exList;
        }

        // 운동 항목 행 추가 (design-expert 제안 + frontend-expert 교정)
        function addExerciseRow($container, data) {
            $container.find('.empty-ex-guide').hide();
            
            const $item = $('<div/>', { 
                class: 'p-2 mb-1 bg-white border rounded shadow-xs position-relative exercise-item pr-5'
            });
            
            // 삭제 버튼
            $item.append($('<button/>', {
                type: 'button',
                class: 'close position-absolute text-muted',
                style: 'top: 50%; right: 10px; transform: translateY(-50%); z-index: 10; outline: none; font-size: 1.2rem; line-height: 1;',
                html: '&times;',
                click: function() { 
                    const $form = $(this).closest('#planForm');
                    $item.remove(); 
                    if ($container.find('.exercise-item').length === 0) {
                        $container.find('.empty-ex-guide').show();
                    }
                    if (typeCode === 'SWIM') updateTotalDistance($form);
                }
            }));

            const $row = $('<div/>', { class: 'form-row no-gutters' }).appendTo($item);
            
            const $colName = $('<div/>', { class: 'col-5 px-1' }).appendTo($row);
            $colName.append($('<input/>', { 
                type: 'text', name: 'exerName', class: 'form-control form-control-sm border-0 font-weight-bold', 
                placeholder: '운동 이름', value: data ? data.planExerName : '' 
            }));

            const metrics = [
                { cls: 'col-2', name: 'sets', ph: 'Set', val: data ? data.planSets : '' },
                { cls: 'col-2', name: 'reps', ph: 'Reps', val: data ? data.planReps : '' },
                { cls: 'col-3', name: 'time', ph: typeCode === 'SWIM' ? 'Distance' : 'Time/Dist', val: data ? (data.planTime || '') : '' }
            ];

            metrics.forEach(m => {
                const $col = $('<div/>', { class: m.cls + ' px-1' }).appendTo($row);
                $col.append($('<input/>', { 
                    type: 'text', name: m.name, class: 'form-control form-control-sm text-center bg-light border-0 rounded-pill', 
                    placeholder: m.ph, value: m.val, style: 'font-size: 0.75rem;'
                }));
            });

            $item.append($('<input/>', {
                type: 'text',
                name: 'memo',
                class: 'form-control form-control-xs mt-1 border-0 bg-transparent text-muted font-italic',
                placeholder: '메모 (클릭하여 입력)',
                value: data ? data.planExercise : '',
                style: 'font-size: 0.7rem; height: auto; padding: 0 5px;'
            }));

            $container.append($item);
            $item.addClass('new-item-highlight');
            setTimeout(() => $item.removeClass('new-item-highlight'), 2000);

            const $phaseList = $container.closest('.phase-list');
            if ($phaseList.length > 0) {
                setTimeout(() => {
                    const containerOffset = $phaseList.offset().top;
                    const itemOffset = $item.offset().top;
                    const currentScroll = $phaseList.scrollTop();
                    const targetScroll = itemOffset - containerOffset + currentScroll - 50;
                    $phaseList.stop().animate({ scrollTop: targetScroll }, 200);
                }, 100);
            }
        }


        // 통합 검색
        $('#tplLibSearch').on('keyup', function() {
            const kw = $(this).val().trim().toLowerCase();
            
            $('#recordListOrigin .record-group').each(function() {
                const $group = $(this);
                const text = $group.text().toLowerCase();
                $group.toggle(text.indexOf(kw) > -1);
            });

            if (!kw) { 
                $('#tplListOrigin').show(); 
                $('#tplSearchResult').hide(); 
                return; 
            }

            $.get('/exercise/plan/search-exercises', { keyword: kw, typeCode: typeCode }, function(data) {
                $('#tplListOrigin').hide();
                const $result = $('#tplSearchResult').empty().show();
                $result.append($('<div/>', { class: 'p-2 bg-light text-muted border-bottom', text: '개별 운동 검색 결과' }));
                
                if (data.length === 0) {
                    $result.append($('<div/>', { class: 'p-4 text-center text-muted', text: '검색 결과가 없습니다.' }));
                }

                data.forEach(ex => {
                    const $div = $('<div/>', { class: 'd-flex align-items-center p-2 border-bottom' });
                    const $check = $('<input/>', {
                        type: 'checkbox',
                        class: 'ex-check',
                        'data-name': ex.tplExerName,
                        'data-sets': ex.tplMeasure1 || '',
                        'data-reps': ex.tplMeasure2 || '',
                        'data-memo': ex.tplNote || ''
                    });

                    let info = `<strong>${ex.tplExerName}</strong>`;
                    if (ex.tplMeasure1 || ex.tplMeasure2) {
                        info += ` <span class="text-primary ml-1">[${ex.tplMeasure1 || 0}S ${ex.tplMeasure2 || 0}R]</span>`;
                    }
                    if (ex.tplNote) {
                        info += `<span class="text-muted ml-1">| ${ex.tplNote}</span>`;
                    }

                    const $label = $('<label/>', {
                        class: 'mb-0 ml-2 cursor-pointer',
                        html: info,
                        click: function() { $check.prop('checked', !$check.prop('checked')); }
                    });
                    $result.append($div.append($check).append($label));
                });
            });
        });

        // 퀵 필터
        $(document).on('click', '.btn-quick-filter', function() {
            const period = $(this).text();
            showToast(period + ' 이내의 기록을 불러옵니다.');
            $(this).siblings().removeClass('active');
            $(this).addClass('active');
        });

        // 운동 담기 (활성화된 페이즈에 추가)
        $(document).on('click', '.btn-add-selected', function() {
            const $checked = $('.ex-check:checked');
            if ($('#planForm').hasClass('d-none')) { alert('작성 폼을 먼저 열어주세요.'); return; }
            
            let $activePhase = $('.phase-item.active');
            if ($activePhase.length === 0) {
                $activePhase = $('.phase-item').last();
            }
            if ($activePhase.length === 0) {
                addPhaseBlock($('#planForm .phase-list'), '본운동');
                $activePhase = $('.phase-item.active');
            }

            const $container = $activePhase.find('.exercise-list');
            if ($checked.length === 0) { alert('추가할 운동을 먼저 선택해주세요.'); return; }
            
            $checked.each(function() {
                const $ex = $(this);
                addExerciseRow($container, { 
                    planExerName: $ex.data('name'), 
                    planSets: $ex.data('sets'), 
                    planReps: $ex.data('reps'), 
                    planExercise: $ex.data('memo') 
                });
                $ex.prop('checked', false);
            });

            if (typeCode === 'SWIM') {
                updateTotalDistance($('#planForm'));
            }

            showToast($checked.length + '개의 운동이 [' + $activePhase.find('input[name=phaseName]').val() + '] 단계에 추가되었습니다.');
        });

        // 아코디언
        $('#tplListOrigin, #recordListOrigin').on('click', '.list-group-item', function() {
            const $this = $(this);
            const $area = $this.next('.tpl-exercises');
            const $icon = $this.find('i.fas');

            if ($area.is(':visible')) {
                $area.slideUp(200);
                $icon.css('transform', 'rotate(0deg)');
            } else {
                $('.tpl-exercises').slideUp(200);
                $('.list-group-item i.fas').css('transform', 'rotate(0deg)');
                
                if ($area.children().length > 0) {
                    $area.slideDown(200);
                    $icon.css('transform', 'rotate(180deg)');
                } else {
                    $.get('/api/exercise/templates/' + $this.data('seq'), function(data) {
                        $area.empty();
                        data.exercises.forEach(ex => {
                            const $div = $('<div/>', { class: 'd-flex align-items-center p-2 border-bottom bg-light', style: 'padding-left: 30px !important;' });
                            const $check = $('<input/>', {
                                type: 'checkbox',
                                class: 'ex-check',
                                'data-name': ex.tplExerName,
                                'data-sets': ex.tplMeasure1 || '',
                                'data-reps': ex.tplMeasure2 || '',
                                'data-memo': ex.tplNote || ''
                            });
                            
                            let info = `<strong>${ex.tplExerName}</strong>`;
                            if (ex.tplMeasure1 || ex.tplMeasure2) {
                                info += ` <span class="text-primary ml-1">[${ex.tplMeasure1 || 0}S ${ex.tplMeasure2 || 0}R]</span>`;
                            }
                            if (ex.tplNote) {
                                info += `<span class="text-muted ml-1">| ${ex.tplNote}</span>`;
                            }

                            const $span = $('<span/>', { 
                                class: 'ml-2 cursor-pointer', 
                                html: info, 
                                click: function() { $check.prop('checked', !$check.prop('checked')); } 
                            });
                            $area.append($div.append($check).append($span));
                        });
                        $area.slideDown(200);
                        $icon.css('transform', 'rotate(180deg)');
                    });
                }
            }
        });

        // 왼쪽 필터
        $('#searchStartDate').datepicker({ dateFormat: 'yy-mm-dd' });
        $('#searchEndDate').datepicker({ dateFormat: 'yy-mm-dd' });
        $('#btnToggleFilter').on('click', function() { $('#advancedFilter').slideToggle(200); });
        $('#btnSearchReset').on('click', function() { $('#searchPlanName, #searchStartDate, #searchEndDate').val(''); });
        $('#btnSearchApply').on('click', function() { alert('검색 실행'); });

        function showToast(msg) {
            const $t = $('<div class="alert alert-info position-fixed fixed-bottom m-3 shadow" style="width: fit-content; left: 50%; transform: translateX(-50%); z-index: 9999; border-radius: 50px;"></div>').text(msg).appendTo('body');
            $t.fadeIn().delay(1500).fadeOut(() => $t.remove());
        }
    });
</script>

<input type="hidden" name="menuCode" value="{{menuCode}}">

<div class="row no-gutters" style="height: calc(100vh - 180px);">
    <!-- 1. 왼쪽: 운동 계획 목록 -->
    <div class="col-lg-3 h-100 pr-2">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-white d-flex align-items-center py-2">
                <span class="mr-auto">운동 계획</span>
                <div class="btn-group btn-group-xs mr-2">
                    {{#typeCode}}
                        <button class="btn btn-xs btn{{^isChecked}}-outline{{/isChecked}}-primary" name="planType" data-type="{{typeCode}}" data-selected="{{isChecked}}">{{codeDesc}}</button>
                    {{/typeCode}}
                </div>
                <button id="btnCreatePlan" class="btn btn-primary btn-xs">추가</button>
            </div>
            <div class="p-2 bg-white border-bottom shadow-xs">
                <div class="input-group input-group-sm">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-transparent border-0 text-muted"><i class="fas fa-search"></i></span>
                    </div>
                    <input type="text" id="searchPlanName" class="form-control border-0 shadow-none px-1" placeholder="계획명 검색...">
                    <div class="input-group-append">
                        <button class="btn btn-link text-muted p-1 d-flex align-items-center" type="button" id="btnToggleFilter" style="text-decoration:none;">
                            <i class="fas fa-filter mr-1"></i>
                            <span>기간검색</span>
                        </button>
                    </div>
                </div>
                <div id="advancedFilter" class="mt-2 p-2 bg-light rounded border" style="display:none;">
                    <div class="d-flex align-items-center bg-white rounded border px-1">
                        <input type="text" id="searchStartDate" class="form-control form-control-sm border-0 shadow-none bg-transparent text-center px-0" placeholder="시작일" readonly style="cursor:pointer; font-size: 0.85rem;">
                        <span class="px-1 text-muted">~</span>
                        <input type="text" id="searchEndDate" class="form-control form-control-sm border-0 shadow-none bg-transparent text-center px-0" placeholder="종료일" readonly style="cursor:pointer; font-size: 0.85rem;">
                    </div>
                    <div class="mt-2 d-flex justify-content-between">
                        <button id="btnSearchReset" class="btn btn-link btn-xs text-muted p-0" style="text-decoration:none;">초기화</button>
                        <button id="btnSearchApply" class="btn btn-primary btn-xs px-2 shadow-sm">필터 적용</button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0 overflow-auto" id="planListContainer">
                <div class="list-group list-group-flush">
                    {{#planList}}
                        <a href="#" class="list-group-item list-group-item-action py-3" data-seq="{{planSeq}}">
                            <span class="badge badge-primary mr-2">{{planDate}}</span>
                            <span>{{planName}}</span>
                        </a>
                    {{/planList}}
                    {{^planList}}
                        <div class="p-5 text-center text-muted">등록된 계획이 없습니다.</div>
                    {{/planList}}
                </div>
            </div>
        </div>
    </div>

    <!-- 2. 중앙: 메인 영역 -->
    <div class="col-lg-6 h-100 px-1">
        <div class="card h-100 shadow-sm border-0 d-flex flex-column" style="overflow: hidden;">
            <div id="emptyPlan" class="flex-grow-1 d-flex flex-column align-items-center justify-content-center bg-light" style="min-height: 0;">
                <div class="text-center mb-4">
                    <div class="display-4 mb-2" id="emptyPlanEmoji">🔥</div>
                    <h5 class="text-dark">어떤 운동을 하실 계획인가요?</h5>
                    <p class="text-muted">목록에서 계획을 선택하거나 아래 버튼을 눌러보세요.</p>
                </div>
                <button id="btnEmptyCreatePlan" class="btn btn-primary px-4 rounded-pill">새 운동 계획 만들기</button>
            </div>
            <div id="planForm" class="card-body d-none p-0 flex-grow-1 flex-column" style="min-height: 0;"></div>
            <div id="planView" class="card-body d-none overflow-auto p-4 flex-grow-1" style="min-height: 0;"></div>
        </div>
    </div>

    <!-- 3. 오른쪽: 라이브러리 -->
    <div class="col-lg-3 h-100 pl-2">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-header bg-white p-0">
                <ul class="nav nav-tabs nav-fill" id="libraryTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active py-2 font-weight-bold" id="tpl-tab" data-toggle="tab" href="#tplTabContent" role="tab">템플릿</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link py-2 font-weight-bold" id="record-tab" data-toggle="tab" href="#recordTabContent" role="tab">과거 기록</a>
                    </li>
                </ul>
            </div>
            <div class="p-2 bg-white border-bottom shadow-xs">
                <div class="input-group input-group-sm">
                    <div class="input-group-prepend">
                        <span class="input-group-text bg-transparent border-0 text-muted"><i class="fas fa-search"></i></span>
                    </div>
                    <input type="text" id="tplLibSearch" class="form-control border-0 shadow-none px-1" placeholder="운동/템플릿 검색...">
                </div>
            </div>
            <div class="card-body p-0 overflow-auto tab-content" id="tplLibContainer">
                <div class="tab-pane fade show active" id="tplTabContent" role="tabpanel">
                    <div class="p-2 bg-white border-bottom">
                        <button class="btn btn-info btn-xs btn-block rounded-pill btn-add-selected">선택한 운동 추가 ↓</button>
                    </div>
                    <div id="tplListOrigin" class="list-group list-group-flush">
                        {{#tplList}}
                            <div class="tpl-group">
                                <a href="javascript:void(0);" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-seq="{{tplSeq}}">
                                    <div><span class="badge badge-primary mr-2">{{tplPhase}}</span><span>{{tplName}}</span></div>
                                    <i class="fas fa-chevron-down text-muted"></i>
                                </a>
                                <div class="tpl-exercises" style="display: none;"></div>
                            </div>
                        {{/tplList}}
                    </div>
                </div>
                <div class="tab-pane fade" id="recordTabContent" role="tabpanel">
                    <div class="p-2 bg-white border-bottom">
                        <div class="d-flex justify-content-between mb-2">
                            <button class="btn btn-xs btn-outline-secondary btn-quick-filter flex-grow-1 mr-1">최근 1주</button>
                            <button class="btn btn-xs btn-outline-secondary btn-quick-filter flex-grow-1">최근 1달</button>
                        </div>
                        <button class="btn btn-info btn-xs btn-block rounded-pill btn-add-selected">선택한 운동 추가 ↓</button>
                    </div>
                    <div id="recordListOrigin" class="list-group list-group-flush">
                        <!-- 더미 데이터 -->
                    </div>
                </div>
                <div id="tplSearchResult" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

<!-- 폼 원본 -->
<div id="planFormBase" class="d-none flex-column flex-grow-1 p-4" style="min-height: 0;">
    <div class="plan-form-header">
        <div class="form-row mb-4">
            <div class="col-md-4">
                <label class="font-weight-bold text-primary">기록 날짜</label>
                <input type="text" name="planDate" class="form-control form-control-sm datepicker" readonly>
            </div>
            <div class="col-md-8">
                <label class="font-weight-bold text-primary">운동 제목</label>
                <input type="text" name="planName" class="form-control form-control-sm" placeholder="계획 제목을 입력하세요">
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <div>
                <span class="text-dark font-weight-bold">운동 프로그램</span>
                <span id="totalDistanceArea" class="badge badge-info ml-2 px-2 py-1 d-none" style="font-size: 0.9rem;">
                    총 <span id="totalDistance">0</span>m
                </span>
            </div>
            <button type="button" class="btn btn-xs btn-outline-primary btn-add-phase px-3 rounded-pill">+ 페이즈(단계) 추가</button>
        </div>
    </div>
    <div class="phase-list flex-grow-1 overflow-auto mb-3 pr-2" style="min-height: 0;"></div>
    <div class="plan-form-footer text-right pt-3 border-top">
        <button type="button" class="btn btn-sm btn-link text-muted btn-cancel-form mr-2">취소</button>
        <button type="button" class="btn btn-sm btn-primary btn-save-plan px-4 shadow-sm">운동 계획 저장</button>
    </div>
</div>
