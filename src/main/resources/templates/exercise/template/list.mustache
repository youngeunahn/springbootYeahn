<script>
    $(document).ready(function() {
        // 운동 순서 버튼 그룹
        $('.phase-group').each(function() {
            const $phaseGroup = $(this);
            const $phaseAllBtn = $phaseGroup.find('button:first-child');
            const $phaseBtns = $phaseGroup.find('button:not(:first-child)');

            $phaseBtns.click(function() {
                $phaseAllBtn.removeClass('active');
                $(this).toggleClass('active');
                $(this).blur();
            });

            $phaseAllBtn.click(function() {
                $phaseBtns.removeClass('active');
                $(this).toggleClass('active');
            });
        });

        // 종류 버튼 그룹
        $('.category-group').each(function() {
            const $catGroup = $(this);
            const $catAllBtn = $catGroup.find('button:first-child');
            const $catBtns = $catGroup.find('button:not(:first-child)');

            $catBtns.click(function() {
                $catAllBtn.removeClass('active');
                $(this).toggleClass('active');
                $(this).blur();
            });

            $catAllBtn.click(function() {
                $catBtns.removeClass('active');
                $(this).toggleClass('active');
            });
        });

        // 운동 선택 클릭이벤트
        $('[name=tplType]').on('click', function() {
            const menuCode = $('[name=menuCode]').val();
            const typeCode = $(this).data('type');
            window.location.href = `/exercise/templates?menuCode=${menuCode}&typeCode=${typeCode}`;
        });

        // 검색 버튼 클릭
        $('#searchBtn').on('click', function() {
            const tplType = $('button[name="tplType"][data-selected="true"]').data('type');
            const tplName = $('#tplName').val();
            const tplPhase = [];
            const tplCategory = [];

            $('.phase-group button.active:not(:first-child)').each(function() {
                tplPhase.push($(this).data('type'));
            });

            $('.category-group button.active:not(:first-child)').each(function() {
                tplCategory.push($(this).data('type'));
            });

            if ($('.phase-group button:first-child').hasClass('active')) tplPhase.length = 0;
            if ($('.category-group button:first-child').hasClass('active')) tplCategory.length = 0;

            const requestData = {
                tplType: tplType,
                tplName: tplName,
                tplPhase: tplPhase,
                tplCategory: tplCategory
            };

            $.ajax({
                url: '/exercise/templates',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                success: function(data) {
                    let html = '';

                    if (!data || data.length === 0) {
                        html = `<div class="p-3 text-center text-muted">데이터 없음</div>`;
                    } else {
                        data.forEach(function(tpl) {
                            html += `
                            <a href="#" class="list-group-item justify-content-between align-items-center" data-seq="${tpl.tplSeq}">
                                <span class="badge badge-primary mr-2">${tpl.tplPhase ?? ''}</span>
                                <span>${tpl.tplName ?? ''}</span>
                            </a>
                            `;
                        });
                    }

                    $('#tplListContainer').html(html);
                }
            });
        });

        // 템플릿 리스트 아이템 클릭 (상세조회)
        $('#tplListContainer').on('click', '.list-group-item', function(e) {
            e.preventDefault();
            const tplSeq = $(this).data('seq');
            if (!tplSeq) return;

            $.ajax({
                url: `/api/exercise/templates/${tplSeq}`,
                type: 'GET',
                success: function(data) {
                    $('#templateForm').empty();
                    let $clone = $('#templateFormBase').clone();
                    $clone.removeAttr('id').show();

                    $clone.find('#siteName').val(data.tplName);
                    $clone.find('#saveTemplateBtn').text('수정').attr('id', 'updateTemplateBtn');
                    $clone.find('#cancelTemplateBtnClone').attr('id', 'closeDetailBtn');

                    // Phase 정보 세팅
                    $.get('/api/codes/TPL_PHASE', function(codes) {
                        let html = '';
                        codes.forEach(code => {
                            const active = (code.typeCode == data.tplPhase) ? 'active' : '';
                            html += `<button type="button" class="btn btn-sm btn-outline-secondary m-1 ${active}" value="${code.typeCode}">${code.codeDesc}</button>`;
                        });
                        $clone.find('#phaseArea').html(html);
                    });

                    // UI 표시
                    $('#emptyTemplate').hide();
                    $('#templateForm').append($clone).slideDown();

                    // 운동 목록 표시
                    if (data.exercises && data.exercises.length > 0) {
                        data.exercises.forEach(function(exer) {
                            addExerciseWithData($clone.find('#addExerciseBtn'), exer);
                        });
                    }

                    // 취소(닫기) 버튼 이벤트
                    $clone.find('#closeDetailBtn').on('click', function() {
                        $('#templateForm').slideUp();
                        $('#emptyTemplate').show();
                    });
                },
                error: function() {
                    alert('상세 정보를 불러오는 데 실패했습니다.');
                }
            });
        });

        $('#childMenuCreate').on('click', function() {

            $('#templateForm').empty();

            let $clone = $('#templateFormBase').clone();
            $clone.removeAttr('id');
            $clone.show();

            $clone.find('input, select, div[id]').each(function(index) {
                const $el = $(this);
                if ($el.attr('id')) {
                    $el.attr('id', $el.attr('id') + '_' + Date.now());
                }
            });

            $('#emptyTemplate').hide();
            $('#templateForm').append($clone);

            $clone.find('.btn-group').first().each(function() {
                const $phaseArea = $(this);
                $.get('/api/codes/TPL_PHASE', function(data) {
                    let html = '';
                    if (data && data.forEach) {
                        data.forEach((item, idx) => {
                            html += `<button type="button"
                                        class="btn btn-sm btn-outline-secondary m-1 ${idx === 0 ? 'active' : ''}"
                                        value="${item.typeCode}">
                                        ${item.codeDesc}
                                </button>`;
                        });
                    }
                    $phaseArea.html(html);
                });
            });

            // addExercise 버튼 이벤트 (clone 내부)
            $clone.find('#addExerciseBtn').off('click').on('click', function() {
                addExercise($(this).closest('#templateForm'));
            });

            // 취소 버튼 이벤트
            $clone.find('#cancelTemplateBtnClone').off('click').on('click', function() {
                $('#templateForm').hide();
                $('#emptyTemplate').show();
            });

            // 등록 버튼 이벤트
            $clone.find('#saveTemplateBtn').off('click').on('click', function () {
                const tplName = $clone.find('input[id^="siteName"]').val();
                const tplPhase = $clone.find('div[id^="phaseArea"] button.active').val();
                const tplTypeCode = $('button[name="tplType"][data-selected="true"]').data('type');

                const exercises = [];
                $clone.find('.list-group .list-group-item').each(function(index) {
                    const $item = $(this);
                    const tplCategoryCode = $item.find('.exercise-part-group button.active').val();
                    const tplKindCode = $item.find('select').val();
                    const tplExerName = $item.find('input[placeholder="운동명"]').val();
                    const tplNote = $item.find('input[placeholder="메모 입력"]').val();

                    if (tplExerName) {
                        exercises.push({
                            tplCategoryCode: tplCategoryCode,
                            tplKindCode: tplKindCode,
                            tplExerName: tplExerName,
                            tplNote: tplNote,
                            tplSortOrder: index + 1
                        });
                    }
                });

                if (!tplName) {
                    alert('템플릿 이름을 입력해주세요.');
                    return;
                }

                if (exercises.length === 0) {
                    alert('운동을 하나 이상 추가해주세요.');
                    return;
                }

                const requestData = {
                    tplTypeCode: tplTypeCode,
                    tplName: tplName,
                    tplPhase: tplPhase,
                    exercises: exercises
                };

                $.ajax({
                    url: '/api/exercise/templates/create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(requestData),
                    success: function(data) {
                        alert('템플릿이 등록되었습니다.');
                        location.reload();
                    },
                    error: function(err) {
                        alert('등록에 실패했습니다.');
                        console.error(err);
                    }
                });
            })

            addExercise($(this).closest('#templateForm'));
            $('#templateForm').slideDown();
        });

        $('#cancelTemplateBtn').on('click', function() {
            $('#templateForm').slideUp();
        });

        // 템플릿 추가폼 운동 순서 클릭 이벤트
        $(document).on('click', '[id^=phaseArea] .btn', function() {
            $(this).siblings().removeClass('active');
            $(this).addClass('active');
        });

        // 템플릿 추가폼 운동 종류 클릭 이벤트
        $(document).on('click', '.exercise-part-group .btn', function() {
            const $group = $(this).closest('.exercise-part-group');

            $group.find('.btn').removeClass('active');
            $(this).addClass('active');
        });

        $('#addExerciseBtn').on('click', function() {
            addExercise();
        });

        $(document).on('click', '.exercise-delete-btn', function() {
            $(this).closest('div.list-group-item').remove();
        });
    });

    function addExerciseWithData($beforeEl, data) {
        const tplType = $('button[name="tplType"][data-selected="true"]').data('type');

        let $item = $('<div>', { class: 'list-group-item' });
        let $partWrap = $('<div>', { class: 'ml-4 mb-2' });
        let $partGroup = $('<div>', {
            class: 'btn-group btn-group-sm exercise-part-group',
            role: 'group'
        });

        $partWrap.append($partGroup);

        let $row = $('<div>', { class: 'd-flex align-items-center' });
        let $drag = $('<span>', {
            class: 'mr-2 drag-handle text-muted',
            text: '☰'
        });

        let $select = "";
        if (tplType == "GYM") {
            $select = $('<select>', {
                class: 'form-control form-control-sm mr-2',
                style: 'width: 80px; background-position: 90% 52%'
            });
        }

        let $name = $('<input>', {
            type: 'text',
            class: 'form-control form-control-sm mr-2',
            placeholder: '운동명',
            style: 'width: 50%;',
            value: data.tplExerName || ''
        });

        $row.append(
            $drag,
            $select,
            $name
        );

        let $memoWrap = $('<div>', { class: 'mt-2 ml-4' });
        let $memo = $('<input>', {
            type: 'text',
            class: 'form-control form-control-sm',
            placeholder: '메모 입력',
            value: data.tplNote || ''
        });

        let $deleteBtn = $('<button>', {
            type: 'button',
            class: 'btn btn-sm btn-secondary exercise-delete-btn position-absolute',
            html: '&times;',
            title: '삭제',
            css: {
                top: '8px',
                right: '8px',
                padding: '4px 10px',
                fontSize: '16px',
                lineHeight: '1',
                borderRadius: '4px'
            }
        });

        // 코드 정보 채우기
        $.ajax({
            url: '/api/exercise/templates',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ ref1: tplType }),
            success: function(codeData) {
                if (codeData && codeData.tplCate) {
                    codeData.tplCate.forEach(function(item){
                        const active = (item.typeCode == data.tplCategoryCode) ? ' active' : '';
                        $partGroup.append(
                            $('<button>', {
                                type: 'button',
                                class: 'btn btn-sm btn-outline-secondary m-1' + active,
                                text: item.codeDesc,
                                value: item.typeCode
                            }),
                        );
                    });
                }

                if (codeData && codeData.tplKind && $select) {
                    codeData.tplKind.forEach(function(item){
                        $select.append(
                            $('<option>', {
                                value: item.typeCode,
                                text: item.codeDesc,
                                selected: (item.typeCode == data.tplKindCode)
                            }),
                        );
                    });
                }
            }
        });

        $memoWrap.append($memo, $deleteBtn);
        $item.append($partWrap, $row, $memoWrap);
        $beforeEl.before($item);
    }

    function addExercise() {

        const tplType = $('button[name="tplType"][data-selected="true"]').data('type');

        let $item = $('<div>', { class: 'list-group-item' });
        let $partWrap = $('<div>', { class: 'ml-4 mb-2' });
        let $partGroup = $('<div>', {
            class: 'btn-group btn-group-sm exercise-part-group',
            role: 'group'
        });

        $partWrap.append($partGroup);

        let $row = $('<div>', { class: 'd-flex align-items-center' });
        let $drag = $('<span>', {
            class: 'mr-2 drag-handle text-muted',
            text: '☰'
        });

        let $select = "";
        if (tplType == "GYM") {
            $select = $('<select>', {
                class: 'form-control form-control-sm mr-2',
                style: 'width: 80px; background-position: 90% 52%'
            });
        }

        let $name = $('<input>', {
            type: 'text',
            class: 'form-control form-control-sm mr-2',
            placeholder: '운동명',
            style: 'width: 50%;'
        });

        $row.append(
                $drag,
                $select,
                $name
        );

        let $memoWrap = $('<div>', { class: 'mt-2 ml-4' });

        let $memo = $('<input>', {
            type: 'text',
            class: 'form-control form-control-sm',
            placeholder: '메모 입력'
        });

        let $deleteBtn = $('<button>', {
            type: 'button',
            class: 'btn btn-sm btn-secondary exercise-delete-btn position-absolute',
            html: '&times;',
            title: '삭제',
            css: {
                top: '8px',
                right: '8px',
                padding: '4px 10px',
                fontSize: '16px',
                lineHeight: '1',
                borderRadius: '4px'
            }
        });

        // tplCategory 옵션 채우기
        $.ajax({
            url: '/api/exercise/templates',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ ref1: tplType }),
            success: function(data) {
                if (data && data.tplCate) {
                    data.tplCate.forEach(function(item){
                        $partGroup.append(
                                $('<button>', {
                                    type: 'button',
                                    class: 'btn btn-sm btn-outline-secondary m-1' + (item.checked ? ' active' : ''),
                                    text: item.codeDesc,
                                    value: item.typeCode
                                }),
                        );
                    });
                }

                if (data && data.tplKind) {
                    data.tplKind.forEach(function(item){
                        $select.append(
                                $('<option>', {
                                    value: item.typeCode
                                    , text: item.codeDesc }),
                        );
                    });
                }
            },
            error: function(err) {
                console.error('템플릿 코드 조회 실패', err);
            }
        });

        $memoWrap.append($memo, $deleteBtn);
        $item.append($partWrap, $row, $memoWrap);
        $('#addExerciseBtn').before($item);
    }
</script>

<input type="hidden" name="menuCode" value="{{menuCode}}">
<div class="row">
    <div class="col-10">
        <div class="card card-body">
            <div class="d-flex">
                <div>
                    <div class="d-flex align-items-center mb-2">
                        <label class="form-label mb-0 mr-0" style="width: 70px;">
                            운동 선택
                        </label>

                        {{#typeCode}}
                            <button class="btn btn-sm btn{{^isChecked}}-outline{{/isChecked}}-primary mr-2"
                                    name="tplType"
                                    data-type="{{typeCode}}"
                                    data-selected="{{isChecked}}"
                                    style="min-width: 15%;">{{codeDesc}}</button>
                        {{/typeCode}}

                        <label for="tplName" class="form-label mb-0 ml-3 mr-2">
                            템플릿
                        </label>

                        <div class="d-flex" style="flex:1; max-width: 400px;">
                            <input type="text" id="tplName" class="form-control" placeholder="템플릿 검색">
                        </div>
                    </div>

                    <!-- 2줄: Phase + Category -->
                    <div class="d-flex align-items-center">

                        <!-- Phase -->
                        <div class="d-flex align-items-center mr-4">
                            <label class="form-label mb-0 mr-0" style="width: 70px;">
                                운동 순서
                            </label>
                            <div class="d-flex flex-wrap phase-group">
                                <button class="btn btn-sm btn-outline-secondary active m-1">전체</button>
                                {{#tplPhase}}
                                    <button class="btn btn-sm btn-outline-secondary m-1" data-type="{{typeCode}}">{{codeDesc}}</button>
                                {{/tplPhase}}
                            </div>
                        </div>

                        <!-- 구분선 -->
                        <div style="width:1px; height:30px; background:#ddd;"></div>

                        <!-- Category -->
                        <div class="d-flex align-items-center ml-4">
                            <label class="form-label mb-0 mr-2">
                                종류
                            </label>
                            <div class="d-flex flex-wrap category-group">
                                <button class="btn btn-sm btn-outline-secondary active m-1">전체</button>
                                {{#tplCategory}}
                                    <button class="btn btn-sm btn-outline-secondary m-1" data-type="{{typeCode}}">{{codeDesc}}</button>
                                {{/tplCategory}}
                            </div>
                        </div>

                    </div>
                </div>

                <!-- 검색 버튼 (2행 병합 느낌) -->
                <div class="ml-3 d-flex align-items-stretch">
                    <button id="searchBtn" class="btn btn-primary d-flex align-items-center justify-content-center"
                            style="width: 80px;">
                        검색
                    </button>
                </div>

            </div>
        </div>
    </div>
    <div class="col-4">
        <h5 class="card-header border-1">
            템플릿 리스트
            <a href="#" id="childMenuCreate" class="btn btn-primary float-right text-white btn-xs" data-toggle="modal" data-target="#insertMenuCodeModal" style="">템플릿 추가</a>
        </h5>
        <div class="card card-body p-0">
            <div class="list-group" id="tplListContainer">
                {{#tplList}}
                    <a href="#" class="list-group-item justify-content-between align-items-center" data-seq="{{tplSeq}}">
                        <span class="badge badge-primary mr-2">{{tplPhase}}</span>
                        <span>{{tplName}}</span>
                    </a>
                {{/tplList}}
            </div>
        </div>
    </div>
    <div class="col-6">
        <h5 class="card-header border-1">템플릿 조회 / 추가</h5>
        <div class="card card-body">
            <div id="emptyTemplate" class="text-center">
                <div class="text-muted" style="padding: 80px 0;">
                    <div style="font-size: 40px;">📋</div>
                    <div style="font-size: 18px; margin-top: 10px;">
                        템플릿을 선택해주세요
                    </div>
                    <div style="font-size: 13px;">
                        왼쪽 목록에서 선택하면 상세 정보가 표시됩니다
                    </div>
                </div>
            </div>

            <div id="templateForm" style="display: none">
            </div>

            <div style="display:none;">
                <div class="col-12 mb-4">
                    <label for="siteName" class="form-label">템플릿 이름</label>
                    <input type="text" class="form-control" id="siteName">
                </div>

                <div class="col-12 mb-4">
                    <label for="siteName" class="form-label">운동 목록</label>
                    <div class="list-group">

                        <div class="list-group-item">

                            <!-- 1줄: 분류 -->
                            <div class="small text-primary mb-1 ml-4">
                                가슴 > 프레스 > 바벨
                            </div>

                            <!-- 2줄: 운동 + 세트 -->
                            <div class="d-flex align-items-center">
                                <span class="mr-2 drag-handle text-muted">☰</span>
                                <span>벤치프레스</span>
                                <span class="badge badge-info ml-2">3세트</span>
                                <span class="badge badge-info ml-1">10회</span>
                            </div>

                            <!-- 3줄: 메모 -->
                            <div class="text-muted small mt-1 ml-4">
                                메모메모메모
                            </div>
                        </div>

                        <div class="list-group-item">
                            <!-- 1줄: 분류 -->
                            <div class="small text-primary mb-1 ml-4">
                                가슴 > 프레스 > 바벨
                            </div>

                            <!-- 2줄: 운동 + 세트 -->
                            <div class="d-flex align-items-center">
                                <span class="mr-2 drag-handle text-muted">☰</span>
                                <span>벤치프레스</span>
                                <span class="badge badge-info ml-2">3세트</span>
                                <span class="badge badge-info ml-1">10회</span>
                            </div>

                            <!-- 3줄: 메모 -->
                            <div class="text-muted small mt-1 ml-4">
                                메모메모메모
                            </div>
                        </div>

                        <div class="list-group-item">

                            <!-- 1줄: 분류 -->
                            <div class="small text-primary mb-1 ml-4">
                                가슴 > 프레스 > 바벨
                            </div>

                            <!-- 2줄: 운동 + 세트 -->
                            <div class="d-flex align-items-center">
                                <span class="mr-2 drag-handle text-muted">☰</span>
                                <span>벤치프레스</span>
                                <span class="badge badge-info ml-2">3세트</span>
                                <span class="badge badge-info ml-1">10회</span>
                            </div>

                            <!-- 3줄: 메모 -->
                            <div class="text-muted small mt-1 ml-4">
                                메모메모메모
                            </div>
                        </div>

                        <button class="btn btn-sm btn-primary mt-2" onclick="addExercise()">
                            + 운동 추가
                        </button>
                    </div>
                </div>

                <div class="text-center" style="">
                    <button class="btn btn-primary border-1 text-white" style="position: center;" onclick="fn_update();">수정</button>
                    <button type="button" class="btn btn-secondary">삭제</button>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- 숨겨진 기본 템플릿 (clone 용) -->
<div id="templateFormBase" style="display:none;">
    <div class="col-12 mb-1">
        <label class="form-label">운동 순서</label>
        <div id="phaseArea" class="btn-group btn-group-sm mr-2" role="group"></div>
    </div>

    <div class="col-12 mb-4">
        <label class="form-label">템플릿 이름</label>
