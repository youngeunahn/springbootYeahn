<script>
    $(document).ready(function() {
        // 운동 순서 버튼 그룹
        $('.phase-group').each(function() {
            const $phaseGroup = $(this);
            const $phaseAllBtn = $phaseGroup.find('button:first-child');
            const $phaseBtns = $phaseGroup.find('button:not(:first-child)');

            $phaseBtns.click(function() {
                $phaseAllBtn.removeClass('active');
                $phaseBtns.removeClass('active');
                $(this).addClass('active');
            });

            $phaseAllBtn.click(function() {
                $phaseBtns.removeClass('active');
                $phaseAllBtn.addClass('active');
            });
        });

        // 종류 버튼 그룹
        $('.category-group').each(function() {
            const $catGroup = $(this);
            const $catAllBtn = $catGroup.find('button:first-child');
            const $catBtns = $catGroup.find('button:not(:first-child)');

            $catBtns.click(function() {
                $catAllBtn.removeClass('active');
                $catBtns.removeClass('active');
                $(this).addClass('active');
            });

            $catAllBtn.click(function() {
                $catBtns.removeClass('active');
                $catAllBtn.addClass('active');
            });
        });

        // 운동 선택 클릭이벤트
        $('[name=tplType]').on('click', function() {
            const menuCode = $('[name=menuCode]').val();
            const typeCode = $(this).data('type');
            window.location.href = `/exercise/templates?menuCode=${menuCode}&typeCode=${typeCode}`;
        });
    });
</script>

<input type="hidden" name="menuCode" value="{{menuCode}}">
<div class="row">
    <div class="col-10">
        <div class="card card-body">
            <div class="d-flex">
                <div>
                    <div class="d-flex align-items-center mb-2">
                        <label class="form-label mb-0 mr-0" style="width: 70px;">
                            운동 선택
                        </label>

                        {{#typeCode}}
                            <button class="btn btn-sm btn{{^isChecked}}-outline{{/isChecked}}-primary mr-2" name="tplType" data-type="{{typeCode}}" style="min-width: 15%;">{{codeDesc}}</button>
                        {{/typeCode}}

                        <label for="tplName" class="form-label mb-0 ml-3 mr-2">
                            템플릿
                        </label>

                        <div class="d-flex" style="flex:1; max-width: 400px;">
                            <input type="text" id="tplName" class="form-control" placeholder="템플릿 검색">
                        </div>
                    </div>

                    <!-- 2줄: Phase + Category -->
                    <div class="d-flex align-items-center">

                        <!-- Phase -->
                        <div class="d-flex align-items-center mr-4">
                            <label class="form-label mb-0 mr-0" style="width: 70px;">
                                운동 순서
                            </label>
                            <div class="d-flex flex-wrap phase-group">
                                <button class="btn btn-sm btn-outline-secondary active m-1">전체</button>
                                {{#tplPhase}}
                                    <button class="btn btn-sm btn-outline-secondary m-1">{{codeDesc}}</button>
                                {{/tplPhase}}
                            </div>
                        </div>

                        <!-- 구분선 -->
                        <div style="width:1px; height:30px; background:#ddd;"></div>

                        <!-- Category -->
                        <div class="d-flex align-items-center ml-4">
                            <label class="form-label mb-0 mr-2">
                                종류
                            </label>
                            <div class="d-flex flex-wrap category-group">
                                <button class="btn btn-sm btn-outline-secondary active m-1">전체</button>
                                {{#tplCategory}}
                                    <button class="btn btn-sm btn-outline-secondary m-1">{{codeDesc}}</button>
                                {{/tplCategory}}
                            </div>
                        </div>

                    </div>
                </div>

                <!-- 검색 버튼 (2행 병합 느낌) -->
                <div class="ml-3 d-flex align-items-stretch">
                    <button class="btn btn-primary d-flex align-items-center justify-content-center"
                            style="width: 80px;">
                        검색
                    </button>
                </div>

            </div>
        </div>
    </div>
    <div class="col-4">
        <h5 class="card-header border-1">
            템플릿 리스트
            <a href="#" id="childMenuCreate" class="btn btn-primary float-right text-white btn-xs" data-toggle="modal" data-target="#insertMenuCodeModal" style="">템플릿 추가</a>
        </h5>
        <div class="card card-body p-0">
            <div class="list-group">
                {{#tplList}}
                    <a href="#" class="list-group-item justify-content-between align-items-center">
                        <span class="badge badge-primary mr-2">{{tplPhase}}</span>
                        <span>{{tplName}}</span>
                    </a>
                {{/tplList}}
            </div>
        </div>
    </div>
    <div class="col-6">
        <h5 class="card-header border-1">템플릿 조회 / 추가</h5>
        <div class="card card-body">
            <div id="emptyTemplate" class="text-center">
