                            <span class="badge badge-info ml-1">10회</span>
                        </div>

                        <!-- 3줄: 메모 -->
                        <div class="text-muted small mt-1 ml-4">
                            메모메모메모
                        </div>
                    </div>

                    <div class="list-group-item">

                        <!-- 1줄: 분류 -->
                        <div class="small text-primary mb-1 ml-4">
                            가슴 > 프레스 > 바벨
                        </div>

                        <!-- 2줄: 운동 + 세트 -->
                        <div class="d-flex align-items-center">
                            <span class="mr-2 drag-handle text-muted">☰</span>
                            <span>벤치프레스</span>
                            <span class="badge badge-info ml-2">3세트</span>
                            <span class="badge badge-info ml-1">10회</span>
                        </div>

                        <!-- 3줄: 메모 -->
